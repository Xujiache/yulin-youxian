# 骑手端非敏感构建参数模板。
# 可以复制为同目录的 gradle.properties，但禁止在工作区文件中写入签名口令或私钥路径。

org.gradle.jvmargs=-Xmx4g -Dfile.encoding=UTF-8
org.gradle.parallel=true
org.gradle.caching=true
android.useAndroidX=true
# 仓库路径含中文目录,关闭 AGP 的非 ASCII 路径检查
android.overridePathCheck=true
android.nonTransitiveRClass=true
kotlin.code.style=official

# ---- release 签名 ----
# 这套 keystore 就是这个 App 的"身份证"。换一套证书签名的包，手机会认为是另一个应用，
# 老用户必须卸载重装，所以 keystore 与口令必须在工作区外单独加密备份。
#
# 默认读取 %USERPROFILE%\.yulin\rider-signing.properties（Linux/macOS 为
# ~/.yulin/rider-signing.properties），也可通过 RIDER_SIGNING_PROPERTIES_FILE
# 环境变量指定另一个工作区外文件。文件包含以下四项：
# RIDER_KEYSTORE_PATH=<keystore 绝对路径>
# RIDER_KEYSTORE_PASSWORD=<keystore 口令>
# RIDER_KEY_ALIAS=<key alias>
# RIDER_KEY_PASSWORD=<key 口令>
#
# CI 也可直接注入同名四个环境变量；环境变量优先于外部文件。
# 缺少任何一项时 release 构建会立即失败，不会生成未签名安装包。

# 服务器地址。默认 release 打到 https://hqhjxt.vip，要改成别的地址时
# 改这里，或者命令行 -PRIDER_BASE_URL=https://your.domain
# RIDER_BASE_URL=https://hqhjxt.vip

# 高德 Key。尚未申请,留空时地图/导航鉴权失败但不崩溃;
# 拿到后填这里或命令行 -PAMAP_KEY=xxx,不需要改任何源码。
# AMAP_KEY=
