.order-detail-page {
  min-height: 100vh;
  padding: 180rpx 24rpx 170rpx;
  background: #f5f6f7;
  box-sizing: border-box;
}

.detail-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 50;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 176rpx;
  padding: 88rpx 24rpx 0;
  background: #f5f6f7;
}

.back,
.placeholder {
  width: 56rpx;
}

.back {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  height: 56rpx;
  z-index: 1;
}

.back-icon {
  width: 36rpx;
  height: 36rpx;
}

.title {
  position: absolute;
  left: 120rpx;
  right: 120rpx;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  color: #101815;
  font-size: 32rpx;
  font-weight: 700;
}

/* Status Banner - High End Meituan Style */
.status-banner {
  margin-bottom: 24rpx;
  padding: 36rpx 32rpx 28rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #00ab58 0%, #007a3d 100%);
  border-radius: 32rpx;
  box-shadow: 0 16rpx 36rpx rgba(0, 122, 61, 0.22);
}

.status-banner.is-completed {
  background: linear-gradient(135deg, #34495e 0%, #2c3e50 100%);
  box-shadow: 0 16rpx 36rpx rgba(44, 62, 80, 0.18);
}

.status-banner.is-cancelled {
  background: linear-gradient(135deg, #7f8c8d 0%, #5d6d7e 100%);
  box-shadow: 0 16rpx 36rpx rgba(93, 109, 126, 0.15);
}

.status-banner.is-closed {
  background: linear-gradient(135deg, #6f7c76 0%, #45554d 100%);
  box-shadow: 0 16rpx 36rpx rgba(69, 85, 77, 0.18);
}

.status-banner.is-refund {
  background: linear-gradient(135deg, #e67e22 0%, #d35400 100%);
  box-shadow: 0 16rpx 36rpx rgba(230, 126, 34, 0.22);
}

.status-banner-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.status-banner-text {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  flex: 1;
  min-width: 0;
}

.status-title {
  font-size: 40rpx;
  font-weight: 900;
  line-height: 50rpx;
  letter-spacing: 0.5rpx;
}

.status-subtitle {
  font-size: 24rpx;
  line-height: 34rpx;
  opacity: 0.92;
}

.status-banner-icon {
  width: 80rpx;
  height: 80rpx;
  flex-shrink: 0;
  opacity: 0.95;
}

.order-no-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.22);
  font-size: 23rpx;
  opacity: 0.92;
}

.order-no-label {
  letter-spacing: 0.5rpx;
}

.copy-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 6rpx 20rpx;
  background: rgba(255, 255, 255, 0.24);
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
}

/* Card Styles */
.card {
  margin-bottom: 24rpx;
  padding: 30rpx 32rpx;
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.035);
}

/* Address Card */
.address-card .card-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.card-icon {
  width: 34rpx;
  height: 34rpx;
}

.card-title {
  color: #1a1a1a;
  font-size: 28rpx;
  font-weight: 800;
}

.address-main {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.address-detail {
  color: #1a1a1a;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 44rpx;
}

.address-contact-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  color: #666666;
  font-size: 26rpx;
}

.address-name {
  font-weight: 600;
}

.delivery-slot-pill {
  display: inline-flex;
  align-items: center;
  justify-content: flex-start;
  gap: 12rpx;
  margin-top: 8rpx;
  padding: 14rpx 20rpx;
  background: #f7f9f8;
  border-radius: 16rpx;
}

.slot-label {
  color: #666666;
  font-size: 24rpx;
  white-space: nowrap;
}

.slot-value {
  color: #007a3d;
  font-size: 24rpx;
  font-weight: 700;
  white-space: nowrap;
}

/* Goods Card */
.store-bar {
  padding-bottom: 22rpx;
  border-bottom: 1rpx solid #f2f4f3;
}

.store-info {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.store-name {
  color: #1a1a1a;
  font-size: 30rpx;
  font-weight: 800;
}

.store-tag {
  padding: 4rpx 12rpx;
  color: #007a3d;
  font-size: 20rpx;
  font-weight: 700;
  background: #e8f7ee;
  border-radius: 8rpx;
}

.goods-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f7f9f8;
}

.goods-item:last-child {
  padding-bottom: 0;
  border-bottom: 0;
}

.goods-image {
  flex-shrink: 0;
  width: 120rpx;
  height: 120rpx;
  background: #f7f9f8;
  border-radius: 20rpx;
}

.goods-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.goods-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #1a1a1a;
  line-height: 38rpx;
}

.goods-spec {
  color: #888888;
  font-size: 23rpx;
}

.goods-count {
  color: #888888;
  font-size: 23rpx;
}

.goods-price {
  font-size: 30rpx;
  color: #1a1a1a;
  font-weight: 800;
}

/* Price Breakdown Card */
.price-card {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.amount-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.amount-label {
  color: #666666;
  font-size: 26rpx;
}

.amount-value {
  color: #333333;
  font-size: 26rpx;
  font-weight: 600;
}

.refund-color {
  color: #e74c3c;
}

.amount-divider {
  height: 1rpx;
  background: #f2f4f3;
  margin: 8rpx 0;
}

.strong-row {
  margin-top: 4rpx;
}

.total-pay-label {
  color: #1a1a1a;
  font-size: 30rpx;
  font-weight: 800;
}

.total-pay-val {
  display: flex;
  align-items: baseline;
}

.pay-symbol {
  color: #007a3d;
  font-size: 26rpx;
  font-weight: 800;
}

.pay-num {
  color: #007a3d;
  font-size: 44rpx;
  font-weight: 900;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
}

/* Notices */
.refund-notice {
  display: flex;
  align-items: center;
  gap: 14rpx;
  color: #9a4a00;
  font-size: 24rpx;
  line-height: 34rpx;
  background: #fff7ed;
  border-radius: 20rpx;
}

.payment-notice {
  color: #6d5200;
  font-size: 24rpx;
  line-height: 34rpx;
  background: #fff9e6;
  border-radius: 20rpx;
}

.payment-route-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 24rpx 26rpx;
  background: linear-gradient(135deg, #ffffff 0%, #f2faf6 100%);
  border: 1rpx solid #e1eee7;
}

.payment-route-icon {
  flex: 0 0 auto;
  width: 68rpx;
  height: 68rpx;
  border-radius: 18rpx;
}

.payment-route-copy {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
}

.payment-route-eyebrow {
  color: #829088;
  font-size: 20rpx;
  line-height: 28rpx;
}

.payment-route-title {
  margin-top: 2rpx;
  color: #17211c;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 38rpx;
}

.payment-route-desc {
  margin-top: 3rpx;
  overflow: hidden;
  color: #718078;
  font-size: 20rpx;
  line-height: 28rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.payment-route-change {
  flex: 0 0 auto;
  padding: 10rpx 18rpx;
  color: #008849;
  font-size: 23rpx;
  font-weight: 700;
  background: #e4f6ec;
  border-radius: 999rpx;
}

/* Bottom Action Bar - Premium Floating Glass Bar */
.detail-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 70;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
  padding: 20rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #ffffff;
  box-shadow: 0 -8rpx 30rpx rgba(0, 0, 0, 0.06);
}

.action-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: 1 1 0;
  width: 0;
  min-width: 0;
  height: 76rpx;
  padding: 0 14rpx;
  margin: 0;
  box-sizing: border-box;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1;
  white-space: nowrap;
  border-radius: 999rpx;
}

.action-btn::after {
  border: 0;
}

.btn-service {
  color: #444444;
  background: #ffffff;
  border: 1.5rpx solid #dcdcdc;
}

.btn-ghost {
  color: #444444;
  background: #ffffff;
  border: 1.5rpx solid #dcdcdc;
}

.btn-cancel {
  color: #a34b3a;
  background: #fff7f3;
  border: 1.5rpx solid #e7b9ad;
}

.btn-primary {
  color: #ffffff;
  background: linear-gradient(135deg, #00b05b 0%, #007a3d 100%);
  border: 0;
  box-shadow: 0 8rpx 24rpx rgba(0, 122, 61, 0.3);
}

.action-btn.is-disabled {
  color: #ffffff;
  background: #b9c1bd;
  border-color: #b9c1bd;
  box-shadow: none;
}

.payment-method-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 130;
  display: flex;
  align-items: flex-end;
  background: rgba(15, 24, 20, 0.52);
  backdrop-filter: blur(8rpx);
}

.payment-method-sheet {
  width: 100%;
  padding: 14rpx 28rpx calc(30rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: linear-gradient(180deg, #ffffff 0%, #fbfdfc 100%);
  border-radius: 38rpx 38rpx 0 0;
  box-shadow: 0 -24rpx 72rpx rgba(8, 36, 22, 0.18);
}

.sheet-handle {
  width: 72rpx;
  height: 8rpx;
  margin: 0 auto 24rpx;
  background: #dfe6e2;
  border-radius: 999rpx;
}

.payment-sheet-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.payment-sheet-title {
  display: block;
  color: #16211b;
  font-size: 36rpx;
  font-weight: 900;
  line-height: 48rpx;
}

.payment-sheet-subtitle {
  display: block;
  margin-top: 8rpx;
  color: #7c8982;
  font-size: 23rpx;
  line-height: 34rpx;
}

.sheet-close {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 56rpx;
  height: 56rpx;
  color: #647169;
  font-size: 42rpx;
  font-weight: 300;
  line-height: 1;
  background: #f1f4f2;
  border-radius: 50%;
}

.payment-lock-tip {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 24rpx;
  padding: 16rpx 20rpx;
  color: #557064;
  font-size: 22rpx;
  line-height: 30rpx;
  background: #edf8f2;
  border: 1rpx solid #d9eee2;
  border-radius: 18rpx;
}

.lock-dot {
  flex: 0 0 auto;
  width: 14rpx;
  height: 14rpx;
  background: #00a957;
  border: 6rpx solid #ccefdc;
  border-radius: 50%;
}

.payment-method-loading {
  padding: 72rpx 0;
  color: #859089;
  font-size: 25rpx;
  text-align: center;
}

.payment-method-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 22rpx;
}

.payment-method-option {
  display: flex;
  align-items: center;
  min-height: 116rpx;
  padding: 18rpx 20rpx;
  box-sizing: border-box;
  background: #f8faf9;
  border: 2rpx solid transparent;
  border-radius: 24rpx;
}

.payment-method-option.is-selected {
  background: linear-gradient(135deg, #f1fbf5 0%, #ffffff 100%);
  border-color: #18a95e;
  box-shadow: 0 10rpx 28rpx rgba(0, 137, 73, 0.09);
}

.payment-method-icon {
  flex: 0 0 auto;
  width: 72rpx;
  height: 72rpx;
  border-radius: 19rpx;
}

.payment-method-copy {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.payment-method-title-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.payment-method-title {
  color: #17211c;
  font-size: 29rpx;
  font-weight: 800;
  line-height: 40rpx;
}

.default-badge,
.current-badge {
  padding: 3rpx 10rpx;
  color: #008a4a;
  font-size: 18rpx;
  font-weight: 700;
  line-height: 26rpx;
  background: #e5f7ed;
  border-radius: 999rpx;
}

.current-badge {
  color: #9a5b20;
  background: #fff1df;
}

.payment-method-desc {
  display: block;
  margin-top: 5rpx;
  color: #818c86;
  font-size: 22rpx;
  line-height: 31rpx;
}

.payment-method-radio {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 38rpx;
  height: 38rpx;
  margin-left: 18rpx;
  box-sizing: border-box;
  border: 2rpx solid #c9d1cd;
  border-radius: 50%;
}

.payment-method-radio.is-checked {
  border: 4rpx solid #00a957;
}

.radio-core {
  width: 14rpx;
  height: 14rpx;
  background: #00a957;
  border-radius: 50%;
}

.payment-method-confirm {
  width: 100%;
  height: 88rpx;
  margin-top: 28rpx;
  color: #ffffff;
  font-size: 29rpx;
  font-weight: 800;
  line-height: 88rpx;
  white-space: nowrap;
  background: linear-gradient(135deg, #00b45f 0%, #007d43 100%);
  border-radius: 999rpx;
  box-shadow: 0 12rpx 26rpx rgba(0, 125, 67, 0.22);
}

.payment-method-confirm::after {
  border: 0;
}

.payment-method-confirm.is-disabled {
  background: #aab8b0;
  box-shadow: none;
}

.payment-method-footnote {
  display: block;
  margin-top: 16rpx;
  color: #98a29d;
  font-size: 20rpx;
  line-height: 30rpx;
  text-align: center;
}

.cancel-modal-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 120;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  box-sizing: border-box;
  background: rgba(16, 24, 21, 0.45);
}

.cancel-modal {
  width: 100%;
  padding: 40rpx 36rpx 32rpx;
  box-sizing: border-box;
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.18);
}

.cancel-modal-title {
  display: block;
  color: #18211d;
  font-size: 34rpx;
  font-weight: 800;
  text-align: center;
}

.cancel-modal-desc {
  display: block;
  margin-top: 18rpx;
  color: #68716d;
  font-size: 26rpx;
  line-height: 38rpx;
  text-align: center;
}

.cancel-modal-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 32rpx;
}

.cancel-choice {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 999rpx;
  font-size: 27rpx;
  font-weight: 700;
  text-align: center;
}

.cancel-discard {
  color: #6f7773;
  background: #f2f4f3;
}

.cancel-return {
  color: #ffffff;
  background: linear-gradient(135deg, #00a957 0%, #007a3d 100%);
}
