<view class="checkout-page {{glassMode ? 'glass-mode' : ''}}">
  <skeleton wx:if="{{loading}}" type="list" />
  <view class="checkout-header">
    <navigator class="back" open-type="navigateBack">
      <image class="back-icon" src="/assets/icons/back-green.svg" mode="aspectFit" />
    </navigator>
    <text class="title">确认订单</text>
    <view class="placeholder"></view>
  </view>

  <view wx:if="{{loadError}}" class="checkout-error card">
    <view class="error-icon">
      <image class="location-icon" src="/assets/icons/clock-green.svg" mode="aspectFit" />
    </view>
    <text class="error-title">订单信息没有加载完整</text>
    <text class="error-desc">{{loadError}}</text>
    <view class="error-actions">
      <button class="ghost-button error-button" bindtap="goCart">返回购物车</button>
      <button class="primary-button error-button" bindtap="handleRetry">重新加载</button>
    </view>
  </view>

  <block wx:else>
    <view class="address card" bindtap="handleChooseAddress">
      <view class="address-icon">
        <image class="location-icon" src="/assets/icons/location-green.svg" mode="aspectFit" />
      </view>
      <view class="address-info">
        <text class="receiver">{{address.detail || '请选择收货地址'}}</text>
        <text class="address-text">{{address.name ? address.name + ' ' + address.phone : '添加或选择一个配送地址'}}</text>
      </view>
      <image class="chevron" src="/assets/icons/chevron-right-gray.svg" mode="aspectFit" />
    </view>

    <view class="slots card">
      <view class="slot-title-row">
        <view class="slot-title-left">
          <image class="slot-icon" src="/assets/icons/clock-green.svg" mode="aspectFit" />
          <view>
            <text class="module-title">预约配送时间</text>
            <text class="slot-subtitle">选择一个方便收货的时间段</text>
          </view>
        </view>
        <text class="slot-badge">门店配送</text>
      </view>
      <view class="slot-list">
        <view
          wx:for="{{slots}}"
          wx:key="id"
          class="slot {{activeSlotId === item.id ? 'active' : ''}}"
          data-id="{{item.id}}"
          bindtap="chooseSlot"
        >
          <text class="slot-label">{{item.label}}</text>
          <text class="slot-check">✓</text>
        </view>
      </view>
    </view>

    <view wx:if="{{deliveryFeeNotice}}" class="fee-banner">
      <text class="fee-banner-title">配送费已减免</text>
      <text class="fee-banner-desc">{{deliveryFeeNotice}}</text>
    </view>

    <view wx:if="{{minOrderAmount && !minOrderMet}}" class="min-order-banner">
      <text class="min-order-banner-title">未满起送价</text>
      <text class="min-order-banner-desc">起送¥{{minOrderText}}，还差¥{{shortfallText}}</text>
    </view>

    <view class="goods card">
      <text class="module-title">禹邻优鲜</text>
      <view wx:for="{{items}}" wx:key="id" class="goods-item">
        <image class="goods-image" src="{{item.image}}" mode="aspectFill" lazy-load="{{true}}" />
        <view class="goods-info">
          <text class="goods-name">{{item.name || item.productName}}</text>
          <text wx:if="{{item.specificationText}}" class="goods-spec">{{item.specificationText}}</text>
          <text class="goods-spec">数量：{{item.quantity}}{{item.saleUnit}}</text>
        </view>
        <text class="goods-price">￥{{item.amountText}}</text>
      </view>
    </view>

    <view class="amount card">
      <view class="amount-row">
        <text>商品总价</text>
        <text>￥{{productAmountText}}</text>
      </view>
      <view class="amount-row">
        <text>配送费</text>
        <text>￥{{deliveryFeeText}}</text>
      </view>
      <view class="amount-row">
        <text>包装费</text>
        <text>￥{{packageFeeText}}</text>
      </view>
      <view wx:if="{{hasLotteryDiscount}}" class="amount-row lottery-discount-row">
        <text>随机减免</text>
        <text>-￥{{lotteryDiscountText}}</text>
      </view>
      <view wx:if="{{minOrderAmount}}" class="amount-row min-order-row">
        <text>起送价</text>
        <text>￥{{minOrderText}}</text>
      </view>
    </view>

    <view class="payment-method card">
      <view class="payment-method-heading">
        <text class="module-title">支付方式</text>
        <text class="payment-method-hint">默认微信支付</text>
      </view>
      <view
        wx:for="{{paymentMethods}}"
        wx:key="code"
        wx:for-index="index"
        class="payment-option {{index === 0 ? 'first' : ''}} {{paymentMethod === item.code ? 'active' : ''}}"
        data-method="{{item.code}}"
        bindtap="handlePaymentMethod"
      >
        <view class="payment-option-icon">
          <image class="payment-option-icon-image" src="{{item.icon}}" mode="aspectFit" />
        </view>
        <view class="payment-option-info">
          <text class="payment-option-title">{{item.title}}</text>
          <text class="payment-option-desc">{{item.desc}}</text>
        </view>
        <view class="payment-radio {{paymentMethod === item.code ? 'checked' : ''}}">
          <text wx:if="{{paymentMethod === item.code}}">✓</text>
        </view>
      </view>
    </view>

    <view class="remark card">
      <text class="module-title">给商家留言</text>
      <textarea class="remark-input" value="{{remark}}" maxlength="200" bindinput="handleRemarkInput" placeholder="例如：请尽快配送，放门口请电话联系" />
    </view>
  </block>

  <view class="pay-bar">
    <text wx:if="{{paying}}" class="pay-processing">支付处理中，请稍候</text>
    <view wx:else class="pay-total">
      <text>合计：</text>
      <text class="pay-price">￥{{totalText}}</text>
      <text wx:if="{{minOrderTip}}" class="pay-min-order {{minOrderMet ? '' : 'is-short'}}">{{minOrderTip}}</text>
    </view>
    <button
      class="primary-button pay-button {{payDisabled || paying || !minOrderMet ? 'disabled' : ''}} {{!minOrderMet ? 'is-min-order' : ''}}"
      disabled="{{payDisabled || paying || !minOrderMet}}"
      bindtap="handlePay"
    >{{paying ? '支付处理中，请稍候' : payLabel}}</button>
  </view>

  <view wx:if="{{showLotteryChoice}}" class="lottery-choice-mask">
    <view class="lottery-choice-sheet">
      <view class="choice-ticket-edge"></view>
      <view class="choice-heading">
        <view class="choice-mark">
          <view class="choice-leaf"></view>
          <text>鲜</text>
        </view>
        <view class="choice-title-copy">
          <text class="choice-eyebrow">菜篮鲜礼签 · 本单可参与</text>
          <text class="choice-title">{{lotteryState.campaign.name || '分享解锁随机鲜礼'}}</text>
        </view>
      </view>
      <text class="choice-desc">{{lotteryState.campaign.shareDescription || '进入朋友圈分享入口后，返回即可抽取本单减免或随单鲜礼。'}}</text>

      <view wx:if="{{wheelPrizes.length}}" class="choice-prizes">
        <view wx:for="{{wheelPrizes}}" wx:key="id" class="choice-prize">
          <image wx:if="{{item.imageUrl}}" class="choice-prize-image" src="{{item.imageUrl}}" mode="aspectFill" />
          <view wx:else class="choice-prize-fallback">
            <view class="choice-produce-leaf"></view>
            <view class="choice-produce"></view>
          </view>
          <text>{{item.name}}</text>
        </view>
      </view>

      <view class="choice-facts">
        <view class="choice-fact"><text class="fact-dot"></text><text>分享后仍由服务端确认资格</text></view>
        <view class="choice-fact"><text class="fact-dot"></text><text>实物鲜礼随本订单一同配送</text></view>
      </view>
      <button
        class="choice-share-button {{lotteryBusy ? 'is-disabled' : ''}}"
        disabled="{{lotteryBusy}}"
        bindtap="handleUnlockLottery"
      >{{lotteryBusy ? '正在准备分享凭证…' : '分享解锁抽奖'}}</button>
      <button
        class="choice-original-button"
        disabled="{{lotteryBusy}}"
        bindtap="handleSkipLottery"
      >不参加，原价支付</button>
      <text class="choice-footnote">不会自动拉起分享；下一页会引导你使用微信右上角菜单</text>
    </view>
  </view>

  <lucky-wheel
    id="checkoutLuckyWheel"
    visible="{{showLuckyWheel}}"
    prizes="{{wheelPrizes}}"
    initial-result="{{wheelInitialResult}}"
    draw-loading="{{drawLoading}}"
    continue-loading="{{lotteryContinueLoading}}"
    continue-text="{{wheelContinueText}}"
    bind:draw="handleLotteryDraw"
    bind:finish="handleLotteryFinish"
    bind:continue="handleLuckyWheelContinue"
    bind:close="handleLuckyWheelClose"
  />
</view>
