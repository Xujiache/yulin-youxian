.checkout-page {
  min-height: 100vh;
  padding: 196rpx 22rpx 150rpx;
  background: #f5f6f7;
}

.checkout-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 50;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 176rpx;
  padding: 88rpx 24rpx 0;
  background: #f5f6f7;
  box-shadow: 0 1rpx 0 rgba(16, 24, 21, 0.04);
}

.back,
.placeholder {
  width: 56rpx;
}

.back {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  height: 56rpx;
  z-index: 1;
}

.back-icon {
  width: 36rpx;
  height: 36rpx;
}

.title {
  position: absolute;
  left: 120rpx;
  right: 120rpx;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  color: #101815;
  font-size: 32rpx;
  font-weight: 700;
}

.card {
  margin-bottom: 22rpx;
  padding: 26rpx;
  border-radius: 24rpx;
}

.module-title {
  display: block;
  color: #101815;
  font-size: 32rpx;
  font-weight: 700;
}

.checkout-error {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 420rpx;
  padding: 58rpx 36rpx;
  text-align: center;
}

.error-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  margin-bottom: 24rpx;
  background: #e8f7ee;
  border-radius: 999rpx;
}

.error-title {
  color: #101815;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 44rpx;
}

.error-desc {
  display: block;
  margin-top: 14rpx;
  color: #66736b;
  font-size: 26rpx;
  line-height: 38rpx;
}

.error-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  width: 100%;
  margin-top: 36rpx;
}

.error-button {
  width: 100%;
}

.address {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 116rpx;
}

.address-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  background: #dff3e7;
  border-radius: 999rpx;
}

.location-icon {
  width: 36rpx;
  height: 36rpx;
}

.address-info {
  flex: 1;
  min-width: 0;
}

.chevron {
  width: 34rpx;
  height: 34rpx;
}

.receiver {
  display: block;
  color: #101815;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 42rpx;
}

.address-text {
  display: block;
  margin-top: 8rpx;
  color: #5b665f;
  font-size: 26rpx;
  line-height: 36rpx;
}

.slot-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}

.slot-title-left {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.slot-icon {
  width: 34rpx;
  height: 34rpx;
}

.slot-subtitle {
  display: block;
  margin-top: 6rpx;
  color: #718078;
  font-size: 22rpx;
  line-height: 30rpx;
}

.slot-badge {
  flex-shrink: 0;
  padding: 8rpx 16rpx;
  color: #007a3d;
  font-size: 22rpx;
  font-weight: 700;
  background: #e8f7ee;
  border-radius: 999rpx;
}

.slot-list {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 22rpx;
}

.slot {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 96rpx;
  padding: 16rpx 20rpx;
  overflow: hidden;
  color: #4f5d55;
  font-size: 24rpx;
  font-weight: 600;
  background: linear-gradient(180deg, #ffffff 0%, #f7faf8 100%);
  border: 1rpx solid #d9e7dd;
  border-radius: 22rpx;
  box-shadow: 0 8rpx 18rpx rgba(8, 34, 20, 0.04);
}

.slot.active {
  color: #ffffff;
  background: linear-gradient(135deg, #007a3d 0%, #1daf59 100%);
  border-color: #007a3d;
  box-shadow: 0 14rpx 28rpx rgba(0, 122, 61, 0.2);
}

.slot-label {
  position: relative;
  z-index: 1;
  width: 100%;
  line-height: 1.45;
  text-align: center;
  word-break: keep-all;
}

.slot-check {
  position: absolute;
  right: 12rpx;
  bottom: 10rpx;
  display: none;
  align-items: center;
  justify-content: center;
  width: 28rpx;
  height: 28rpx;
  color: #007a3d;
  font-size: 18rpx;
  font-weight: 800;
  background: #ffffff;
  border-radius: 999rpx;
}

.slot.active .slot-check {
  display: flex;
}

.fee-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 22rpx;
  padding: 22rpx 26rpx;
  color: #007a3d;
  background: linear-gradient(135deg, #e8f7ee 0%, #ffffff 100%);
  border: 1rpx solid rgba(0, 122, 61, 0.12);
  border-radius: 24rpx;
  box-shadow: 0 10rpx 28rpx rgba(8, 34, 20, 0.05);
}

.fee-banner-title {
  flex-shrink: 0;
  font-size: 28rpx;
  font-weight: 800;
}

.fee-banner-desc {
  flex: 1;
  color: #4f5d55;
  font-size: 24rpx;
  line-height: 34rpx;
  text-align: right;
}

.min-order-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 22rpx;
  padding: 20rpx 26rpx;
  color: #b54735;
  background: #fff7f5;
  border: 1rpx solid rgba(181, 71, 53, 0.14);
  border-radius: 24rpx;
}

.min-order-banner-title {
  flex-shrink: 0;
  font-size: 26rpx;
  font-weight: 800;
}

.min-order-banner-desc {
  flex: 1;
  color: #8a5a50;
  font-size: 24rpx;
  line-height: 34rpx;
  text-align: right;
}

.min-order-row {
  color: #7a8680;
}

.goods-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #edf1ef;
}

.goods-item:last-child {
  border-bottom: 0;
}

.goods-image {
  width: 116rpx;
  height: 116rpx;
  background: #eef3ef;
  border-radius: 16rpx;
}

.goods-info {
  flex: 1;
  min-width: 0;
}

.goods-name {
  display: block;
  color: #101815;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 38rpx;
}

.goods-spec {
  display: block;
  margin-top: 8rpx;
  color: #627068;
  font-size: 24rpx;
}

.goods-price {
  color: #101815;
  font-size: 28rpx;
  font-weight: 700;
}

.amount-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  color: #4f5d55;
  font-size: 26rpx;
}

.lottery-discount-row {
  color: #008a52;
  font-weight: 700;
}

.payment-method-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.payment-method-hint {
  color: #8a9590;
  font-size: 22rpx;
}

.payment-option {
  display: flex;
  align-items: center;
  min-height: 92rpx;
  padding: 16rpx 0;
  border-top: 1rpx solid #eef1ef;
}

.payment-option.first {
  border-top: 0;
}

.payment-option-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 52rpx;
  height: 52rpx;
  margin-right: 18rpx;
  border-radius: 14rpx;
  overflow: hidden;
}

.payment-option-icon-image {
  width: 100%;
  height: 100%;
}

.payment-option-info {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  gap: 6rpx;
}

.payment-option-title {
  color: #17211c;
  font-size: 28rpx;
  font-weight: 700;
}

.payment-option-desc {
  color: #86908b;
  font-size: 22rpx;
  line-height: 30rpx;
}

.payment-radio {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 32rpx;
  height: 32rpx;
  margin-left: 16rpx;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 800;
  border: 2rpx solid #cbd3cf;
  border-radius: 50%;
  box-sizing: border-box;
}

.payment-radio.checked {
  background: #008a52;
  border-color: #008a52;
}

.remark-input {
  width: 100%;
  height: 128rpx;
  margin-top: 18rpx;
  padding: 18rpx;
  color: #101815;
  font-size: 26rpx;
  background: #f7f8f8;
  border: 1rpx solid #d3ded7;
  border-radius: 16rpx;
}

.pay-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 70;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 20rpx 24rpx 34rpx;
  background: #ffffff;
  box-shadow: 0 -10rpx 32rpx rgba(10, 34, 22, 0.1);
}

.pay-total {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  align-items: flex-start;
  color: #4f5d55;
  font-size: 24rpx;
}

.pay-processing {
  flex: 1;
  color: #007a3d;
  font-size: 24rpx;
  font-weight: 700;
}

.pay-price {
  color: #007a3d;
  font-size: 48rpx;
  font-weight: 800;
}

.pay-min-order {
  margin-top: 2rpx;
  color: #7a8680;
  font-size: 20rpx;
  line-height: 28rpx;
}

.pay-min-order.is-short {
  color: #b54735;
}

.pay-button {
  min-width: 246rpx;
  min-height: 88rpx;
}

.pay-button.is-min-order {
  min-width: 268rpx;
  font-size: 24rpx;
}

.pay-button.disabled {
  color: rgba(255, 255, 255, 0.72);
  background: #9fb3a8;
  box-shadow: none;
}

.lottery-choice-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 160;
  display: flex;
  align-items: flex-end;
  padding: 24rpx 22rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: rgba(18, 32, 25, 0.62);
  backdrop-filter: blur(10rpx);
  -webkit-backdrop-filter: blur(10rpx);
}

.lottery-choice-sheet {
  position: relative;
  width: 100%;
  padding: 32rpx 28rpx 24rpx;
  overflow: hidden;
  color: #122019;
  background:
    linear-gradient(90deg, rgba(0, 138, 82, 0.035) 1rpx, transparent 1rpx),
    #fff8e7;
  background-size: 22rpx 22rpx;
  border: 2rpx solid rgba(244, 201, 93, 0.78);
  border-radius: 38rpx;
  box-shadow: 0 30rpx 80rpx rgba(3, 45, 26, 0.3);
}

.choice-ticket-edge {
  position: absolute;
  top: 0;
  right: 0;
  left: 0;
  height: 12rpx;
  background: repeating-linear-gradient(90deg, #008a52 0, #008a52 32rpx, #f4c95d 32rpx, #f4c95d 64rpx);
}

.choice-heading {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.choice-mark {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 76rpx;
  height: 76rpx;
  color: #fff8e7;
  font-family: "STKaiti", "KaiTi", sans-serif;
  font-size: 38rpx;
  font-weight: 900;
  background: linear-gradient(145deg, #60c041, #008a52);
  border: 5rpx solid #f4c95d;
  border-radius: 24rpx 24rpx 30rpx 30rpx;
}

.choice-leaf {
  position: absolute;
  top: -13rpx;
  right: 3rpx;
  width: 27rpx;
  height: 38rpx;
  background: #006d42;
  border-radius: 26rpx 4rpx 26rpx 4rpx;
  transform: rotate(38deg);
}

.choice-title-copy {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
}

.choice-eyebrow {
  color: #008a52;
  font-size: 19rpx;
  font-weight: 800;
  line-height: 28rpx;
  letter-spacing: 2rpx;
}

.choice-title {
  margin-top: 4rpx;
  overflow: hidden;
  color: #122019;
  font-family: "STKaiti", "KaiTi", "PingFang SC", sans-serif;
  font-size: 36rpx;
  font-weight: 900;
  line-height: 48rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.choice-desc {
  display: block;
  margin-top: 20rpx;
  color: #5f6f67;
  font-size: 23rpx;
  line-height: 36rpx;
}

.choice-prizes {
  width: 100%;
  margin-top: 22rpx;
  white-space: nowrap;
}

.choice-prizes-inner {
  display: inline-flex;
  gap: 14rpx;
  padding-right: 12rpx;
}

.choice-prize {
  display: inline-flex;
  align-items: center;
  width: 142rpx;
  min-width: 142rpx;
  padding: 12rpx 10rpx;
  flex-direction: column;
  color: #26362d;
  font-size: 20rpx;
  font-weight: 700;
  background: rgba(255, 255, 255, 0.72);
  border: 2rpx solid rgba(0, 138, 82, 0.13);
  border-radius: 20rpx;
}

.choice-prize-image,
.choice-prize-fallback {
  width: 112rpx;
  height: 86rpx;
  margin-bottom: 9rpx;
  overflow: hidden;
  background: #eaf7e4;
  border-radius: 15rpx;
}

.choice-prize-fallback {
  position: relative;
}

.choice-produce {
  position: absolute;
  top: 30rpx;
  left: 34rpx;
  width: 48rpx;
  height: 42rpx;
  background: #60c041;
  border-radius: 50% 50% 42% 42%;
}

.choice-produce-leaf {
  position: absolute;
  top: 10rpx;
  left: 56rpx;
  z-index: 1;
  width: 21rpx;
  height: 34rpx;
  background: #006d42;
  border-radius: 22rpx 4rpx 22rpx 4rpx;
  transform: rotate(30deg);
}

.choice-facts {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-top: 22rpx;
  padding: 18rpx 20rpx;
  color: #52635a;
  font-size: 21rpx;
  line-height: 31rpx;
  background: rgba(0, 138, 82, 0.075);
  border-radius: 18rpx;
}

.choice-fact {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.fact-dot {
  flex: 0 0 auto;
  width: 10rpx;
  height: 10rpx;
  background: #60c041;
  border: 4rpx solid #d7edcd;
  border-radius: 50%;
}

.choice-share-button,
.choice-original-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 86rpx;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 86rpx;
  border-radius: 999rpx;
}

.choice-share-button {
  margin-top: 24rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #008a52 0%, #006d42 100%);
  box-shadow: 0 14rpx 28rpx rgba(0, 109, 66, 0.22);
}

.choice-share-button.is-disabled {
  background: #9aaba1;
  box-shadow: none;
}

.choice-original-button {
  margin-top: 12rpx;
  color: #006d42;
  background: transparent;
}

.choice-share-button::after,
.choice-original-button::after {
  border: 0;
}

.choice-footnote {
  display: block;
  margin-top: 8rpx;
  color: #859189;
  font-size: 19rpx;
  line-height: 28rpx;
  text-align: center;
}
