page {
  background: #f6f8f4;
}

.activity-page {
  min-height: 100vh;
  box-sizing: border-box;
  color: #17352a;
  background: #f6f8f4;
}

.activity-page.is-normal {
  padding: 28rpx 24rpx 220rpx;
}

.activity-page.is-landing {
  padding: 32rpx 24rpx calc(48rpx + env(safe-area-inset-bottom));
}

.activity-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 70vh;
  flex-direction: column;
  gap: 22rpx;
  color: #6d7a72;
  font-size: 24rpx;
}

.loading-ring {
  width: 56rpx;
  height: 56rpx;
  border: 6rpx solid #dce8df;
  border-top-color: #0a8a52;
  border-radius: 50%;
  animation: ring-spin 800ms linear infinite;
}

@keyframes ring-spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

.landing-head,
.landing-notice,
.landing-prizes-card,
.landing-rules {
  margin: 0 0 22rpx;
  padding: 32rpx 30rpx;
  background: #ffffff;
  border-radius: 24rpx;
}

.landing-kicker,
.landing-title,
.landing-desc {
  display: block;
}

.landing-kicker {
  color: #0a8a52;
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
}

.landing-title {
  margin-top: 8rpx;
  color: #17352a;
  font-size: 40rpx;
  font-weight: 900;
  line-height: 52rpx;
}

.landing-desc {
  margin-top: 12rpx;
  color: #5f6f67;
  font-size: 24rpx;
  line-height: 38rpx;
}

.landing-notice {
  text-align: center;
}

.landing-notice-title,
.landing-notice-desc {
  display: block;
}

.landing-notice-title {
  color: #17352a;
  font-size: 28rpx;
  font-weight: 900;
}

.landing-notice-desc {
  margin-top: 10rpx;
  color: #68776f;
  font-size: 23rpx;
  line-height: 35rpx;
}

.landing-prizes-title {
  display: block;
  color: #17352a;
  font-size: 26rpx;
  font-weight: 900;
}

.landing-prizes {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 18rpx;
}

.landing-prize {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 90rpx;
  padding: 12rpx;
  border-radius: 18rpx;
}

.landing-prize.tone-0 {
  color: #ffffff;
  background: #0a8a52;
}

.landing-prize.tone-1 {
  color: #17352a;
  background: #f5c04e;
}

.landing-prize.tone-2 {
  color: #ffffff;
  background: #1d8f5f;
}

.landing-prize.tone-3 {
  color: #17352a;
  background: #f4f0e2;
}

.landing-prize-name {
  font-size: 24rpx;
  font-weight: 800;
  text-align: center;
}

.landing-rules {
  color: #5f6f67;
  font-size: 23rpx;
  line-height: 36rpx;
}

.landing-rules-title {
  display: block;
  margin-bottom: 10rpx;
  color: #17352a;
  font-size: 26rpx;
  font-weight: 900;
}

.landing-rules-line {
  display: block;
}

.landing-footnote {
  display: block;
  margin-top: 24rpx;
  color: #8b978f;
  font-size: 20rpx;
  text-align: center;
}

.guide-head {
  padding: 30rpx 28rpx;
  color: #ffffff;
  background: #0a8a52;
  border-radius: 26rpx;
}

.guide-kicker,
.guide-title,
.guide-desc {
  display: block;
}

.guide-kicker {
  color: rgba(255, 255, 255, 0.82);
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
}

.guide-title {
  margin-top: 8rpx;
  overflow: hidden;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 46rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.guide-desc {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.86);
  font-size: 22rpx;
  line-height: 32rpx;
}

.guide-menu {
  margin-top: 24rpx;
  padding: 30rpx 26rpx 26rpx;
  text-align: center;
  background: #ffffff;
  border-radius: 22rpx;
}

.guide-menu-dots {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 84rpx;
  height: 50rpx;
  margin: 0 auto 12rpx;
  color: #0a8a52;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 32rpx;
  background: #edf5f0;
  border-radius: 999rpx;
}

.guide-menu-title,
.guide-menu-desc {
  display: block;
}

.guide-menu-title {
  color: #17352a;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 42rpx;
}

.guide-menu-desc {
  margin-top: 6rpx;
  color: #617168;
  font-size: 22rpx;
  line-height: 32rpx;
}

.guide-steps {
  margin-top: 24rpx;
  padding: 30rpx 28rpx;
  background: #ffffff;
  border-radius: 22rpx;
}

.guide-step {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.step-index {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 44rpx;
  height: 44rpx;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 900;
  background: #0a8a52;
  border-radius: 50%;
}

.step-title,
.step-desc {
  display: block;
}

.step-title {
  color: #17352a;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 38rpx;
}

.step-desc {
  margin-top: 4rpx;
  color: #69776f;
  font-size: 21rpx;
  line-height: 31rpx;
}

.step-rail {
  width: 4rpx;
  height: 30rpx;
  margin: 2rpx 0 2rpx 22rpx;
  background: #d3e3d8;
  border-radius: 999rpx;
}

.activity-alert,
.activity-status,
.activity-error {
  margin-top: 20rpx;
  padding: 22rpx 24rpx;
  border-radius: 18rpx;
}

.activity-alert {
  color: #6f5614;
  font-size: 22rpx;
  line-height: 33rpx;
  background: #f9efce;
}

.activity-status {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: #0a8a52;
  font-size: 22rpx;
  line-height: 33rpx;
  background: #e7f4ec;
}

.status-dot {
  flex: 0 0 auto;
  width: 12rpx;
  height: 12rpx;
  background: #f5c04e;
  border-radius: 50%;
}

.activity-status.is-success .status-dot {
  background: #0a8a52;
}

.activity-error {
  background: #ffffff;
}

.activity-error-title,
.activity-error-desc {
  display: block;
}

.activity-error-title {
  color: #17352a;
  font-size: 26rpx;
  font-weight: 900;
}

.activity-error-desc {
  margin-top: 8rpx;
  color: #68766f;
  font-size: 22rpx;
  line-height: 33rpx;
}

.activity-error-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 18rpx;
}

.error-retry,
.error-back {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 74rpx;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 74rpx;
  border-radius: 999rpx;
}

.error-retry {
  color: #0a8a52;
  background: #edf5f0;
}

.error-back {
  color: #ffffff;
  background: #0a8a52;
}

.activity-bottom-space {
  height: 10rpx;
}

.activity-actions {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  padding: 16rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(246, 248, 244, 0.96);
  border-top: 2rpx solid rgba(10, 138, 82, 0.12);
}

.actions-tip {
  display: block;
  margin-bottom: 12rpx;
  color: #718078;
  font-size: 20rpx;
  line-height: 29rpx;
  text-align: center;
}

.actions-row {
  display: flex;
  gap: 16rpx;
}

.back-button,
.original-button,
.return-draw-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 82rpx;
  font-size: 27rpx;
  font-weight: 900;
  line-height: 82rpx;
  border-radius: 999rpx;
}

.back-button {
  flex: 1;
  color: #0a8a52;
  background: #ffffff;
}

.original-button {
  flex: 1.2;
  color: #ffffff;
  background: #0a8a52;
}

.return-draw-button {
  width: 100%;
  color: #17352a;
  background: #f5c04e;
}

.back-button::after,
.original-button::after,
.return-draw-button::after,
.error-retry::after,
.error-back::after {
  border: 0;
}

button[disabled] {
  color: rgba(255, 255, 255, 0.7);
  background: #9db0a6;
}
