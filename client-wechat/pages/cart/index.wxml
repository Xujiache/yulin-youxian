<view class="cart-page {{glassMode ? 'glass-mode' : ''}}">
  <skeleton wx:if="{{loading}}" type="list" has-tabbar="{{true}}" />
  <view class="page-header">
    <view class="cart-heading">
      <text class="page-title">购物车</text>
      <text class="page-subtitle">{{items.length ? '共 ' + items.length + ' 件商品' : '新鲜好物，随心选购'}}</text>
    </view>
    <text class="clear {{selectedCount ? '' : 'disabled'}}" bindtap="handleClearSelected">清空已选</text>
  </view>

  <view wx:if="{{!items.length && !loading}}" class="cart-empty">
    <view class="empty-line">
      <image class="empty-line-icon" src="/assets/icons/tab-cart-active.svg" mode="aspectFit" />
      <view class="empty-copy">
        <text class="empty-title">购物车是空的</text>
        <text class="empty-desc">先看看今天到店的新鲜好物</text>
      </view>
      <button class="empty-link" bindtap="goHome">去逛逛</button>
    </view>

    <view wx:if="{{recommendedProducts.length}}" class="recommend-section">
      <view class="recommend-head">
        <text class="recommend-title">为你推荐</text>
        <text class="recommend-subtitle">门店精选</text>
      </view>
      <view class="recommend-grid">
        <product-card
          wx:for="{{recommendedProducts}}"
          wx:key="id"
          product="{{item}}"
          bind:add="handleAddRecommended"
        />
      </view>
    </view>
  </view>

  <view wx:else class="cart-content">
    <view class="cart-overview">
      <view class="overview-icon"><text>鲜</text></view>
      <view class="overview-copy">
        <text class="overview-title">门店直送，新鲜到家</text>
        <text class="overview-desc">价格与库存以结算时为准</text>
      </view>
      <view class="overview-count">
        <text class="overview-count-value">{{availableCount}}</text>
        <text class="overview-count-label">件可结算</text>
      </view>
    </view>

    <view wx:if="{{unavailableCount}}" class="availability-notice">
      <view class="notice-mark">!</view>
      <text class="notice-copy">有 {{unavailableCount}} 件商品状态发生变化，已为你标记</text>
      <text class="notice-action {{clearingUnavailable ? 'disabled' : ''}}" bindtap="handleClearUnavailable">
        {{clearingUnavailable ? '清理中' : '清理失效'}}
      </text>
    </view>

    <view class="cart-list">
      <view wx:for="{{items}}" wx:key="id" class="cart-item card {{item.unavailable ? 'is-unavailable' : ''}}">
        <view class="cart-main">
          <view
            class="check {{item.unavailable ? 'is-disabled' : (item.selected ? 'checked' : '')}}"
            data-id="{{item.id}}"
            bindtap="handleToggle"
          >
            <image wx:if="{{item.selected && !item.unavailable}}" class="check-icon" src="/assets/icons/check-white.svg" mode="aspectFit" />
            <text wx:elif="{{item.unavailable}}" class="check-disabled-mark">×</text>
          </view>
          <view class="item-image-wrap">
            <image class="item-image" src="{{item.image}}" mode="aspectFill" lazy-load="{{true}}" />
            <text wx:if="{{item.unavailable}}" class="item-status-cover">{{item.availabilityLabel}}</text>
          </view>
          <view class="item-info">
            <text class="item-name">{{item.name}}</text>
            <text class="item-subtitle">{{item.subtitle}}</text>
            <view
              wx:if="{{!item.unavailable && (item.skuId || item.skuSelectionRequired || item.reselectionRequired)}}"
              class="item-spec {{item.canReselectSku ? 'is-editable' : ''}}"
              data-id="{{item.id}}"
              bindtap="handleReselectSku"
            >
              <text class="item-spec-text">{{item.specificationText || '规格已调整，请重新选择'}}</text>
              <text wx:if="{{item.canReselectSku}}" class="item-spec-action">修改</text>
            </view>
            <text wx:if="{{item.unavailable}}" class="item-unavailable-tip">{{item.availabilityMessage}}</text>
            <view wx:if="{{!item.unavailable}}" class="item-bottom">
              <text class="item-price">￥{{item.amountText}}</text>
              <view class="cart-stepper-shell">
                <quantity-stepper
                  data-id="{{item.id}}"
                  value="{{item.quantity}}"
                  min="{{item.minPurchaseQty || 1}}"
                  max="{{item.stockQty}}"
                  step="{{item.stepQty || 1}}"
                  unit="{{item.saleUnit || ''}}"
                  bind:change="handleQuantityChange"
                />
              </view>
            </view>
            <view wx:else class="item-invalid-price-row">
              <text class="item-price">￥{{item.amountText}}</text>
            </view>
          </view>
        </view>
        <view
          wx:if="{{item.unavailable}}"
          class="item-invalid-actions {{item.canReselectSku ? 'has-reselect' : 'delete-only'}}"
        >
          <button
            wx:if="{{item.canReselectSku}}"
            class="item-action-button reselect"
            data-id="{{item.id}}"
            data-source="bottom-action"
            bindtap="handleReselectSku"
          >重选规格</button>
          <button
            class="item-action-button delete"
            data-id="{{item.id}}"
            disabled="{{deletingItemId === item.id}}"
            bindtap="handleDeleteItem"
          >{{deletingItemId === item.id ? '删除中' : '删除'}}</button>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{items.length}}" class="checkout-bar">
    <view class="checkout-meta">
      <view class="select-group {{availableCount ? '' : 'muted'}}" bindtap="handleToggleAll">
        <view class="check {{allAvailableSelected ? 'checked' : ''}}">
          <image wx:if="{{allAvailableSelected}}" class="check-icon" src="/assets/icons/check-white.svg" mode="aspectFit" />
        </view>
        <text class="select-all">全选</text>
      </view>
      <view class="total">
        <text class="total-label">已选 {{selectedCount}} 件 · 合计</text>
        <text class="total-price">￥{{totalText}}</text>
      </view>
    </view>
    <button class="primary-button checkout-button {{selectedCount && !checkoutPreparing ? '' : 'disabled'}}" disabled="{{!selectedCount || checkoutPreparing}}" bindtap="handleCheckout">
      <text>{{checkoutPreparing ? '核对中' : '去结算'}}</text>
      <image class="checkout-arrow" src="/assets/icons/chevron-right-white.svg" mode="aspectFit" />
    </button>
  </view>

  <cart-add-sheet
    visible="{{sheetVisible}}"
    product="{{selectedProduct}}"
    action-mode="{{sheetActionMode}}"
    initial-sku-id="{{sheetInitialSkuId}}"
    initial-quantity="{{sheetInitialQuantity}}"
    bind:close="handleCloseSheet"
    bind:confirm="handleConfirmSheet"
  />

  <app-tabbar active="cart" cart-count="{{items.length}}" />
</view>
