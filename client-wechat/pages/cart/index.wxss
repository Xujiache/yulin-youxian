.cart-page {
  min-height: 100vh;
  padding: 196rpx 22rpx 344rpx;
  background: #eef4f0;
}

.cart-page .page-header {
  /* 给微信右上角胶囊按钮留出更大的安全区，避免“清空已选”被遮挡 */
  padding-right: 300rpx;
}

.cart-heading {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 4rpx;
}

.page-subtitle {
  color: #607067;
  font-size: 22rpx;
  line-height: 30rpx;
}

.clear {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 132rpx;
  height: 56rpx;
  padding: 0 22rpx;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #00a957 0%, #007a3d 100%);
  border: 0;
  border-radius: 999rpx;
  box-shadow: 0 8rpx 18rpx rgba(0, 122, 61, 0.2);
}

.clear.disabled {
  color: #9aa5a0;
  background: #edf0ee;
  border-color: #edf0ee;
  box-shadow: none;
}

.cart-content {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.cart-overview {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 24rpx 28rpx;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 18rpx rgba(0, 0, 0, 0.04);
}

.overview-logo-img {
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
  border-radius: 16rpx;
  object-fit: contain;
}

.overview-icon {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 900;
  background: linear-gradient(135deg, #00b05b 0%, #007a3d 100%);
  border-radius: 20rpx;
}

.overview-copy {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  gap: 5rpx;
}

.overview-title {
  color: #142019;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 34rpx;
}

.overview-desc {
  color: #637169;
  font-size: 21rpx;
  line-height: 29rpx;
}

.overview-count {
  display: flex;
  flex-shrink: 0;
  align-items: baseline;
  gap: 4rpx;
  color: #4f6057;
}

.overview-count-value {
  color: #087d46;
  font-size: 36rpx;
  font-weight: 850;
}

.overview-count-label {
  font-size: 20rpx;
}

.availability-notice {
  display: flex;
  align-items: center;
  flex-wrap: nowrap;
  gap: 12rpx;
  min-height: 72rpx;
  padding: 14rpx 18rpx;
  background: #fff7f2;
  border: 1rpx solid #f0d7c9;
  border-radius: 18rpx;
  box-sizing: border-box;
}

.glass-mode .cart-overview {
  background: rgba(255, 255, 255, 0.66);
  border-color: rgba(255, 255, 255, 0.84);
  box-shadow: var(--shadow-soft);
  backdrop-filter: blur(var(--glass-blur)) saturate(145%);
  -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(145%);
}

.glass-mode .availability-notice {
  background: rgba(255, 247, 242, 0.78);
  border-color: rgba(240, 215, 201, 0.82);
  backdrop-filter: blur(var(--glass-blur)) saturate(130%);
  -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(130%);
}

.notice-mark {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 34rpx;
  height: 34rpx;
  color: #a24632;
  font-size: 22rpx;
  font-weight: 850;
  line-height: 1;
  background: #f7dfd3;
  border-radius: 50%;
}

.notice-copy {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
  height: 34rpx;
  overflow: hidden;
  color: #714b3f;
  font-size: 21rpx;
  line-height: 34rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.notice-action {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  height: 34rpx;
  color: #9c3f2e;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 34rpx;
  white-space: nowrap;
}

.notice-action.disabled {
  color: #a6958e;
}

.cart-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.cart-empty {
  display: flex;
  flex-direction: column;
  gap: 26rpx;
  background: transparent;
}

.empty-line {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 126rpx;
  padding: 22rpx 24rpx;
  background: #ffffff;
  border: 1rpx solid rgba(0, 122, 61, 0.07);
  border-radius: 24rpx;
  box-shadow: 0 10rpx 28rpx rgba(8, 34, 20, 0.05);
}

.empty-line-icon {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  padding: 19rpx;
  box-sizing: border-box;
  background: #eef8f2;
  border-radius: var(--radius-pill);
}

.empty-copy {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  gap: 6rpx;
  text-align: left;
}

.empty-title {
  color: #101815;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 36rpx;
}

.empty-desc {
  display: block;
  color: #66736b;
  font-size: 23rpx;
  line-height: 30rpx;
}

.empty-link {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 144rpx;
  height: 56rpx;
  padding: 0;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 56rpx;
  background: #008a45;
  border-radius: 999rpx;
  box-shadow: 0 10rpx 24rpx rgba(0, 138, 69, 0.18);
}

.empty-link::after {
  border: 0;
}

.recommend-section {
  margin-top: 2rpx;
}

.glass-mode .cart-empty,
.glass-mode .recommend-section {
  background: transparent;
  border: 0;
  box-shadow: none;
  backdrop-filter: none;
  -webkit-backdrop-filter: none;
}

.glass-mode .empty-line {
  background: rgba(255, 255, 255, 0.72);
  border-color: rgba(255, 255, 255, 0.88);
  box-shadow: 0 14rpx 34rpx rgba(25, 73, 47, 0.13), inset 0 1rpx 0 rgba(255, 255, 255, 0.84);
  backdrop-filter: blur(var(--glass-blur)) saturate(145%);
  -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(145%);
}

.glass-mode .empty-line-icon {
  background: rgba(226, 247, 235, 0.9);
}

.glass-mode .empty-link {
  color: #ffffff;
  background: linear-gradient(135deg, #008f55 0%, #006d42 100%);
  border: 0;
  box-shadow: 0 10rpx 24rpx rgba(0, 109, 66, 0.2), inset 0 1rpx 0 rgba(255, 255, 255, 0.2);
}

.recommend-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 0 4rpx 18rpx;
}

.recommend-title {
  color: #101815;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 42rpx;
}

.recommend-subtitle {
  color: #7b8781;
  font-size: 23rpx;
}

.recommend-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.cart-item {
  display: flex;
  flex-direction: column;
  overflow: hidden;
  padding: 24rpx;
  background: #ffffff;
  border: 1rpx solid #dbe7df;
  border-radius: 24rpx;
  box-shadow: 0 10rpx 26rpx rgba(20, 62, 38, 0.07);
}

.cart-item.is-unavailable {
  background: #f8faf8;
  border-color: #e2e7e3;
  box-shadow: 0 8rpx 22rpx rgba(35, 48, 40, 0.05);
}

.cart-main {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.check {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34rpx;
  height: 34rpx;
  border: 2rpx solid #cbd6cf;
  border-radius: 50%;
}

.check.checked {
  color: #ffffff;
  background: #07864a;
  border-color: #07864a;
}

.check.is-disabled {
  color: #8f9a94;
  background: #e8ece9;
  border-color: #dce2de;
}

.check-disabled-mark {
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1;
}

.check-icon {
  width: 24rpx;
  height: 24rpx;
}

.item-image-wrap {
  position: relative;
  flex-shrink: 0;
  width: 150rpx;
  height: 150rpx;
  overflow: hidden;
  background: #eef3ef;
  border-radius: 20rpx;
}

.item-image {
  width: 100%;
  height: 100%;
}

.cart-item.is-unavailable .item-image {
  filter: grayscale(68%);
  opacity: 0.62;
}

.item-status-cover {
  position: absolute;
  left: 50%;
  top: 50%;
  padding: 8rpx 12rpx;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 700;
  white-space: nowrap;
  background: rgba(37, 47, 42, 0.84);
  border-radius: 999rpx;
  transform: translate(-50%, -50%);
}

.item-info {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  min-height: 150rpx;
}

.item-name {
  display: block;
  overflow: hidden;
  color: #101815;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 40rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-subtitle {
  display: block;
  margin-top: 8rpx;
  overflow: hidden;
  color: #626d66;
  font-size: 26rpx;
  line-height: 36rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-spec {
  display: flex;
  align-items: center;
  align-self: flex-start;
  max-width: 100%;
  gap: 10rpx;
  margin-top: 7rpx;
  padding: 6rpx 12rpx;
  color: #66736b;
  font-size: 21rpx;
  background: #f1f5f2;
  border-radius: 8rpx;
}

.item-spec.is-editable {
  color: #176b47;
  background: #e9f6ef;
}

.item-spec-text {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-spec-action {
  flex-shrink: 0;
  color: #008a52;
  font-weight: 750;
}

.item-unavailable-tip {
  display: block;
  margin-top: 9rpx;
  padding: 7rpx 10rpx;
  color: #8f3f2f;
  font-size: 21rpx;
  font-weight: 600;
  line-height: 29rpx;
  background: #fff4ee;
  border-radius: 9rpx;
}

.item-price {
  display: block;
  color: #007a3d;
  font-size: 46rpx;
  font-weight: 800;
}

.item-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  margin-top: auto;
}

.cart-item-controls {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  gap: 10rpx;
  max-width: 100%;
}

.item-delete-quick {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 76rpx;
  width: 76rpx;
  min-width: 76rpx;
  max-width: 76rpx;
  height: 44rpx;
  padding: 0;
  box-sizing: border-box;
  overflow: hidden;
  color: #9c4938;
  font-size: 20rpx;
  font-weight: 650;
  line-height: 44rpx;
  background: #fff5f1;
  border: 1rpx solid #f3d6cd;
  border-radius: 999rpx;
}

.item-delete-quick::after {
  border: 0;
}

.item-delete-quick[disabled] {
  color: #a6aaa7;
  background: #f0f2f1;
}

.item-invalid-price-row {
  display: flex;
  align-items: baseline;
  margin-top: auto;
  padding-top: 12rpx;
}

.item-invalid-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  width: 100%;
  min-width: 0;
  gap: 14rpx;
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #e2e8e4;
}

.item-invalid-actions.delete-only .delete {
  grid-column: 2;
}

.item-action-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-width: 0;
  max-width: 100%;
  height: 56rpx;
  min-height: 56rpx;
  margin: 0;
  padding: 0 12rpx;
  box-sizing: border-box;
  font-size: 22rpx;
  font-weight: 750;
  line-height: 1;
  background: #ffffff;
  border-radius: 999rpx;
}

.item-action-button::after {
  border: 0;
}

.item-action-button.reselect {
  color: #087d46;
  border: 1rpx solid #9fceb6;
}

.item-action-button.delete {
  color: #a13f2e;
  border: 1rpx solid #e4b5a8;
}

.item-action-button[disabled] {
  color: #9a9f9c;
  background: #f0f2f1;
  border-color: #e2e5e3;
}

.cart-stepper-shell {
  width: 190rpx;
  max-width: 190rpx;
  flex-shrink: 0;
}

.item-unavailable-action {
  flex-shrink: 0;
  color: #8d4a3b;
  font-size: 23rpx;
  font-weight: 700;
}

.item-unavailable-action.is-action {
  color: #008a52;
}

.cart-item.is-unavailable .item-price {
  color: #748078;
}

.checkout-bar {
  position: fixed;
  left: 18rpx;
  right: 18rpx;
  bottom: calc(140rpx + env(safe-area-inset-bottom));
  z-index: 70;
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 112rpx;
  padding: 16rpx 18rpx;
  box-sizing: border-box;
  background: #ffffff;
  border-radius: 36rpx;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.12);
}

.checkout-meta {
  display: flex;
  flex: 1;
  min-width: 0;
  align-items: center;
  gap: 12rpx;
  overflow: hidden;
}

.select-group {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  gap: 6rpx;
}

.select-group.muted {
  opacity: 0.45;
}

.select-all {
  color: #1a1a1a;
  font-size: 24rpx;
  font-weight: 500;
  white-space: nowrap;
}

.total {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  justify-content: center;
  gap: 2rpx;
  overflow: hidden;
}

.total-main {
  display: flex;
  align-items: baseline;
  gap: 2rpx;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
}

.total-label {
  flex-shrink: 0;
  color: #1a1a1a;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1;
  white-space: nowrap;
}

.total-symbol {
  flex-shrink: 0;
  color: #ff4b2b;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1;
  white-space: nowrap;
}

.total-price-integer {
  flex-shrink: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #ff4b2b;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
}

.total-sub {
  display: flex;
  align-items: center;
  gap: 6rpx;
  margin-top: 4rpx;
  color: #888888;
  font-size: 19rpx;
  line-height: 24rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.total-count {
  flex-shrink: 0;
  color: #888888;
  white-space: nowrap;
}

.min-order-tip {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #888888;
}

.min-order-tip.is-short {
  color: #ff4b2b;
  font-weight: 600;
}

.checkout-button {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  flex-shrink: 0;
  width: 172rpx;
  min-width: 172rpx;
  height: 76rpx;
  padding: 0 16rpx;
  box-sizing: border-box;
  font-size: 26rpx;
  font-weight: 800;
  background: linear-gradient(135deg, #00b05b 0%, #007a3d 100%);
  border-radius: 999rpx;
  box-shadow: 0 8rpx 20rpx rgba(0, 122, 61, 0.28);
}

.checkout-button.is-min-order {
  width: 200rpx;
  min-width: 200rpx;
  padding: 0 12rpx;
  font-size: 22rpx;
}

.checkout-button.disabled {
  color: #ffffff;
  background: #cccccc;
  box-shadow: none;
}

.checkout-arrow {
  width: 20rpx;
  height: 20rpx;
}

.checkout-arrow {
  width: 24rpx;
  height: 24rpx;
}
