<view class="detail-page {{glassMode ? 'glass-mode' : ''}}">
  <skeleton wx:if="{{loading}}" type="detail" />
  <view class="detail-header">
    <view class="back" bindtap="handleBack">
      <image class="back-icon" src="/assets/icons/back-green.svg" mode="aspectFit" />
    </view>
    <text class="title">商品详情</text>
  </view>

  <view class="product-hero-wrap {{unavailable ? 'is-unavailable' : ''}}">
    <image class="product-hero" src="{{product.image}}" mode="aspectFill" />
    <view wx:if="{{unavailable}}" class="sold-out-cover">
      <text class="sold-out-cover-title">{{availabilityLabel}}</text>
      <text class="sold-out-cover-tip">{{availabilityLabel === '商品已下架' ? '请选择其他商品' : '补货后即可购买'}}</text>
    </view>
  </view>

  <view class="info card {{unavailable ? 'is-unavailable' : ''}}">
    <view class="name-row">
      <text class="name">{{product.name}}</text>
      <text wx:if="{{product.badge}}" class="badge">{{product.badge}}</text>
    </view>
    <text class="subtitle">{{product.subtitle}}</text>
    <view class="price-row">
      <text class="price">￥{{amountText}}</text>
      <text class="unit">当前小计</text>
    </view>
    <text wx:if="{{!unavailable}}" class="stock">库存充足，约 {{product.stockQty}}{{product.saleUnit}}</text>
    <text wx:else class="stock stock-empty">{{availabilityLabel}}，暂时无法购买</text>
  </view>

  <view class="buy-card card {{unavailable ? 'is-unavailable' : ''}}">
    <view class="buy-head">
      <view class="buy-copy">
        <text class="buy-title">购买数量</text>
        <text wx:if="{{!unavailable}}" class="buy-tip">{{product.minPurchaseQty}}{{product.saleUnit}} 起购，每次增加 {{product.stepQty}}{{product.saleUnit}}</text>
        <text wx:else class="buy-tip buy-tip-empty">{{availabilityLabel === '商品已下架' ? '当前商品已下架，请选择其他商品' : '当前无可购买库存，请等待商家补货'}}</text>
      </view>
      <text class="buy-current {{unavailable ? 'buy-current-empty' : ''}}">{{unavailable ? availabilityLabel : '已选 ' + quantity + product.saleUnit}}</text>
    </view>
    <view wx:if="{{!unavailable}}" class="buy-stepper-row">
      <quantity-stepper
        class="buy-stepper"
        value="{{quantity}}"
        min="{{product.minPurchaseQty || 1}}"
        max="{{product.stockQty}}"
        step="{{product.stepQty || 1}}"
        unit="{{product.saleUnit || ''}}"
        bind:change="handleQuantityChange"
      />
    </view>
  </view>

  <view class="desc card">
    <text class="desc-title">商品详情</text>
    <text class="desc-text">产地直采，新鲜到店。生鲜产品受季节、气候等因素影响，外观及口感可能略有差异，请以实物为准。</text>
  </view>

  <view class="detail-footer">
    <view class="footer-quick-actions">
      <button class="footer-quick footer-share" open-type="share">
        <image class="footer-quick-icon" src="/assets/icons/share-generated.png" mode="aspectFit" />
        <text>分享</text>
      </button>
      <view class="footer-quick cart-quick" bindtap="goCart">
        <view class="footer-cart-icon-wrap">
          <image class="footer-quick-icon" src="/assets/icons/cart-generated.png" mode="aspectFit" />
          <text wx:if="{{cartCount > 0}}" class="footer-cart-badge">{{cartCount}}</text>
        </view>
        <text>购物车</text>
      </view>
    </view>

    <view class="footer-purchase">
      <button class="footer-add-cart {{unavailable ? 'purchase-disabled' : ''}}" bindtap="handleAddCart">加入购物车</button>
      <button class="footer-buy-now {{unavailable ? 'purchase-disabled' : ''}}" bindtap="handleBuyNow">
        <text class="footer-buy-price">￥{{amountText}}</text>
        <text>{{unavailable ? availabilityLabel : '立即购买'}}</text>
      </button>
    </view>
  </view>
</view>
