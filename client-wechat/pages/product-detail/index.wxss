.detail-page {
  min-height: 100vh;
  padding: 24rpx 22rpx 148rpx;
  background: #f5f6f7;
}

.detail-header {
  position: absolute;
  top: 0;
  left: 22rpx;
  right: 22rpx;
  z-index: 50;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 176rpx;
  padding: 88rpx 24rpx 0;
  box-sizing: border-box;
  background: transparent;
}

.back {
  color: #007a3d;
  font-size: 28rpx;
}

.back {
  position: absolute;
  left: 24rpx;
  bottom: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  min-width: 0;
  padding: 0;
  margin: 0;
  box-sizing: border-box;
  z-index: 1;
  background: #e8f7ee;
  border: 0;
  border-radius: 999rpx;
  line-height: 1;
}

.back::after {
  border: 0;
}

.back-icon {
  width: 32rpx;
  height: 32rpx;
}

.title {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  max-width: 320rpx;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.3);
}

.glass-mode .detail-header {
  background: transparent;
  box-shadow: none;
  backdrop-filter: none;
  -webkit-backdrop-filter: none;
}

.product-hero-wrap {
  position: relative;
  width: 100%;
  height: 500rpx;
  margin-top: 68rpx;
  overflow: hidden;
  background: #eef3ef;
  border-radius: 34rpx;
  box-shadow: 0 12rpx 30rpx rgba(8, 34, 20, 0.06);
}

.product-hero {
  display: block;
  width: 100%;
  height: 100%;
  background: #eef3ef;
  transition: filter 180ms ease-out, opacity 180ms ease-out;
}

.product-hero-wrap.is-unavailable .product-hero {
  filter: grayscale(70%);
  opacity: 0.58;
}

.sold-out-cover {
  position: absolute;
  left: 50%;
  top: 52%;
  display: flex;
  align-items: center;
  flex-direction: column;
  justify-content: center;
  min-width: 230rpx;
  padding: 20rpx 28rpx;
  color: #ffffff;
  background: rgba(20, 31, 26, 0.78);
  border-radius: 18rpx;
  transform: translate(-50%, -50%);
}

.sold-out-cover-title {
  font-size: 32rpx;
  font-weight: 800;
  line-height: 42rpx;
}

.sold-out-cover-tip {
  margin-top: 4rpx;
  color: rgba(255, 255, 255, 0.9);
  font-size: 22rpx;
  line-height: 32rpx;
}

.info,
.buy-card,
.spec-entry,
.desc {
  margin-top: 24rpx;
  padding: 28rpx;
  border-radius: 26rpx;
}

.name-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}

.name {
  flex: 1;
  min-width: 0;
  color: #101815;
  font-size: 40rpx;
  font-weight: 800;
}

.badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  white-space: nowrap;
  padding: 6rpx 14rpx;
  color: #1e5b2b;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1;
  background: #e8f4df;
  border-radius: 10rpx;
}

.subtitle,
.stock,
.buy-tip,
.desc-text {
  display: block;
  margin-top: 12rpx;
  color: #5f6b64;
  font-size: 26rpx;
  line-height: 40rpx;
}

.stock-empty,
.buy-tip-empty {
  color: #a53b2b;
  font-weight: 600;
}

.price-row {
  display: flex;
  align-items: flex-end;
  gap: 12rpx;
  margin-top: 22rpx;
}

.min-order-hint {
  display: block;
  margin-top: 10rpx;
  color: #7a8680;
  font-size: 22rpx;
  line-height: 30rpx;
}

.min-order-hint {
  display: block;
  margin-top: 12rpx;
  color: #7a8680;
  font-size: 22rpx;
  line-height: 30rpx;
}

.price {
  color: #007a3d;
  font-size: 58rpx;
  font-weight: 800;
}

.info.is-unavailable .price {
  color: #68716c;
}

.unit {
  padding-bottom: 8rpx;
  color: #5f6b64;
  font-size: 24rpx;
}

.buy-card {
  display: block;
}

.buy-title,
.desc-title {
  display: block;
  color: #101815;
  font-size: 32rpx;
  font-weight: 700;
}

.buy-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.buy-copy {
  flex: 1;
  min-width: 0;
}

.buy-current {
  flex-shrink: 0;
  padding: 8rpx 16rpx;
  color: #007a3d;
  font-size: 24rpx;
  font-weight: 700;
  background: #e8f7ee;
  border-radius: 999rpx;
}

.buy-stepper-row {
  display: flex;
  justify-content: flex-end;
  margin-top: 24rpx;
}

.buy-stepper {
  width: 232rpx;
}

.detail-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 80;
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 16rpx 20rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -10rpx 32rpx rgba(10, 34, 22, 0.1);
}

.price-range {
  padding-bottom: 5rpx;
  color: #007a3d;
  font-size: 28rpx;
  font-weight: 750;
}

.spec-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.spec-entry-copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 7rpx;
}

.spec-entry-title {
  color: #101815;
  font-size: 30rpx;
  font-weight: 800;
}

.spec-entry-tip {
  color: #68756d;
  font-size: 22rpx;
}

.spec-entry-action {
  display: flex;
  align-items: center;
  gap: 6rpx;
  color: #008a52;
  font-size: 23rpx;
  font-weight: 700;
}

.spec-entry-arrow {
  width: 24rpx;
  height: 24rpx;
}

.footer-quick-actions {
  display: flex;
  flex: 1 1 0;
  min-width: 0;
  align-items: center;
  justify-content: space-between;
}

.footer-quick {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 4rpx;
  flex: 1;
  min-width: 0;
  padding: 0;
  color: #27342e;
  font-size: 20rpx;
  line-height: 26rpx;
  background: transparent;
  border: 0;
}

.footer-quick::after {
  border: 0;
}

.footer-quick-icon {
  width: 42rpx;
  height: 42rpx;
  object-fit: contain;
}

.footer-cart-icon-wrap {
  position: relative;
  width: 42rpx;
  height: 42rpx;
}

.footer-cart-badge {
  position: absolute;
  top: -12rpx;
  right: -16rpx;
  min-width: 24rpx;
  height: 24rpx;
  padding: 0 5rpx;
  color: #ffffff;
  font-size: 16rpx;
  line-height: 24rpx;
  text-align: center;
  background: #e53935;
  border: 2rpx solid #ffffff;
  border-radius: 999rpx;
}

.buy-current-empty {
  color: #8a3b2f;
  background: #f8e9e5;
}

.footer-purchase {
  display: flex;
  flex: 3 1 0;
  min-width: 0;
  height: 88rpx;
  overflow: hidden;
  border-radius: 24rpx;
  box-shadow: 0 10rpx 24rpx rgba(0, 122, 61, 0.16);
}

.footer-add-cart,
.footer-buy-now {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 50%;
  min-width: 0;
  height: 88rpx;
  padding: 0 10rpx;
  margin: 0;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 1.2;
}

.footer-add-cart {
  color: #007a3d;
  background: #e4f5eb;
  border-radius: 24rpx 0 0 24rpx;
}

.footer-buy-now {
  flex-direction: column;
  gap: 3rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #009a5b 0%, #006d42 100%);
  border-radius: 0 24rpx 24rpx 0;
}

.footer-buy-price {
  font-size: 23rpx;
  font-weight: 700;
}

.footer-add-cart.purchase-disabled {
  color: #68716c;
  background: #e7ebe8;
  box-shadow: none;
}

.footer-buy-now.purchase-disabled {
  color: #ffffff;
  background: #8b948f;
  box-shadow: none;
}
