<view class="orders-page {{glassMode ? 'glass-mode' : ''}}">
  <skeleton wx:if="{{loading}}" type="list" has-tabbar="{{true}}" />
  <view class="page-header">
    <text class="page-title">我的订单</text>
  </view>

  <view class="tabs-wrap">
    <view class="status-tabs">
      <view
        wx:for="{{tabs}}"
        wx:key="*this"
        class="status-tab {{activeStatus === item ? 'active' : ''}}"
        data-status="{{item}}"
        bindtap="handleTab"
      >
        {{item}}
      </view>
    </view>
  </view>

  <view wx:if="{{!orders.length}}" class="empty-orders">
    <view class="empty-paper">
      <view class="paper-head">
        <text class="paper-dot"></text>
        <text>{{needsLogin ? '订单同步' : '订单记录'}}</text>
      </view>
      <view class="paper-line strong"></view>
      <view class="paper-line"></view>
      <view class="paper-line short"></view>
      <view class="paper-footer">
        <text>配送</text>
        <text>支付</text>
        <text>售后</text>
      </view>
    </view>
    <text class="empty-title">{{emptyTitle}}</text>
    <text class="empty-desc">{{emptyDesc}}</text>
    <button wx:if="{{needsLogin}}" class="primary-button empty-action" bindtap="goLogin">去登录</button>
    <button wx:else class="primary-button empty-action" bindtap="goHome">去逛逛</button>
  </view>

  <view wx:else class="order-list">
    <view wx:for="{{orders}}" wx:key="id" class="order-card card" data-id="{{item.id}}" bindtap="goDetail">
      <view class="order-head">
        <view class="order-head-left">
          <text class="store-name">禹邻优鲜门店</text>
          <image class="store-arrow" src="/assets/icons/chevron-right-gray.svg" mode="aspectFit" />
        </view>
        <text class="order-status {{item.status === '待支付' ? 'is-pending' : ''}} {{item.status === '已关闭' ? 'is-closed' : ''}}">{{item.status}}</text>
      </view>

      <view wx:if="{{item.refundNotice}}" class="refund-notice">
        <text>{{item.refundNotice}}</text>
      </view>

      <view class="order-body">
        <!-- 单件商品：美团大厂左侧大图+商品名称+数量，右侧总价 -->
        <block wx:if="{{item.isSingleProduct}}">
          <image class="single-thumb" src="{{item.images[0]}}" mode="aspectFill" lazy-load="{{true}}" />
          <view class="single-info">
            <text class="single-name">{{item.singleProductName}}</text>
            <text wx:if="{{item.singleProductSpec}}" class="single-spec">{{item.singleProductSpec}}</text>
            <text class="single-count">x{{item.singleProductQuantity}}</text>
          </view>
          <view class="order-meta">
            <view class="total-price-wrap">
              <text class="total-label-text">实付</text>
              <text class="total-currency">￥</text>
              <text class="total-amount">{{item.totalText}}</text>
            </view>
            <text wx:if="{{item.deliverySlot}}" class="delivery-time-text">预约配送：{{item.deliverySlot}}</text>
          </view>
        </block>

        <!-- 多件商品：美团大厂横向图片画廊 + 总件数与实付款 -->
        <block wx:else>
          <view class="multi-thumbs-wrapper">
            <scroll-view class="multi-thumbs-scroll" scroll-x="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
              <view class="multi-thumbs-inner">
                <image wx:for="{{item.images}}" wx:key="*this" class="multi-thumb" src="{{item}}" mode="aspectFill" lazy-load="{{true}}" />
              </view>
            </scroll-view>
          </view>
          <view class="order-meta multi-meta">
            <text class="total-count-text">共 {{item.totalItemCount}} 件</text>
            <view class="total-price-wrap">
              <text class="total-label-text">实付</text>
              <text class="total-currency">￥</text>
              <text class="total-amount">{{item.totalText}}</text>
            </view>
          </view>
        </block>
      </view>

      <view wx:if="{{item.primaryActionText || item.secondaryActionText}}" class="order-actions">
        <button
          wx:if="{{item.secondaryActionText}}"
          class="order-btn btn-secondary"
          data-id="{{item.id}}"
          catchtap="handleSecondaryAction"
        >
          {{item.secondaryActionText}}
        </button>
        <button
          wx:if="{{item.primaryActionText}}"
          class="order-btn {{item.status === '待支付' || item.status === '已关闭' ? 'btn-pay' : 'btn-primary'}}"
          data-id="{{item.id}}"
          catchtap="handleOrderAction"
        >
          {{item.primaryActionText}}
        </button>
      </view>
    </view>
  </view>

  <app-tabbar active="orders" cart-count="{{cartCount}}" />
</view>
