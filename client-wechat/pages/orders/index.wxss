.orders-page {
  min-height: 100vh;
  padding: 286rpx 24rpx 164rpx;
  background:
    radial-gradient(circle at 90% 6%, rgba(194, 230, 208, 0.46), transparent 25%),
    linear-gradient(180deg, #edf4ef 0%, #eaf1ed 45%, #f5f7f6 100%);
}

.tabs-wrap {
  position: fixed;
  top: 176rpx;
  left: 0;
  right: 0;
  z-index: 45;
  padding: 12rpx 24rpx;
  background: transparent;
}

.status-tabs {
  display: grid;
  grid-template-columns: repeat(7, minmax(0, 1fr));
  gap: 4rpx;
  height: 76rpx;
  padding: 6rpx;
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.status-tab {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  height: 62rpx;
  padding: 0 2rpx;
  overflow: hidden;
  color: #5b665f;
  font-size: 21rpx;
  font-weight: 600;
  border-radius: 16rpx;
  white-space: nowrap;
}

.status-tab.active {
  color: #007a3d;
  font-weight: 800;
  background: #e8f7ee;
}

.order-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.empty-orders {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 560rpx;
  padding: 48rpx 34rpx;
  text-align: center;
  background: #ffffff;
  border-radius: var(--radius-card);
  box-shadow: 0 10rpx 28rpx rgba(8, 34, 20, 0.05);
}

.empty-paper {
  width: 260rpx;
  padding: 24rpx 22rpx 22rpx;
  background: #f8fbf9;
  border: 2rpx solid #e2eee7;
  border-radius: var(--radius-card);
}

.paper-head {
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: #007a3d;
  font-size: 22rpx;
  font-weight: 900;
}

.paper-dot {
  width: 16rpx;
  height: 16rpx;
  background: #008a45;
  border-radius: var(--radius-pill);
}

.paper-line {
  height: 14rpx;
  margin-top: 16rpx;
  background: #e5f2ea;
  border-radius: var(--radius-pill);
}

.paper-line.strong {
  width: 100%;
  background: #cfe8d8;
}

.paper-line.short {
  width: 66%;
}

.paper-footer {
  display: flex;
  justify-content: space-between;
  margin-top: 22rpx;
  color: #7b8781;
  font-size: 20rpx;
}

.empty-title {
  margin-top: 30rpx;
  color: #101815;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 46rpx;
}

.empty-desc {
  display: block;
  max-width: 520rpx;
  margin-top: 14rpx;
  color: #5b665f;
  font-size: 25rpx;
  line-height: 38rpx;
}

.empty-action {
  min-width: 220rpx;
  margin-top: 34rpx;
}

.order-card {
  padding: 24rpx 28rpx;
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.04);
}

.order-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f2f4f3;
}

.order-head-left {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.store-name {
  color: #1a1a1a;
  font-size: 28rpx;
  font-weight: 700;
}

.store-arrow {
  width: 20rpx;
  height: 20rpx;
}

.order-status {
  flex-shrink: 0;
  color: #666666;
  font-size: 26rpx;
  font-weight: 600;
}

.order-status.is-pending {
  color: #007a3d;
  font-weight: 800;
}

.refund-notice {
  margin-top: 18rpx;
  padding: 14rpx 18rpx;
  color: #9a4a00;
  font-size: 22rpx;
  line-height: 32rpx;
  background: #fff7ed;
  border-radius: 12rpx;
}

.order-body {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 24rpx 0 16rpx;
}

/* 单件商品：大图 + 商品名描述 */
.single-thumb {
  flex-shrink: 0;
  width: 120rpx;
  height: 120rpx;
  background: #f7f9f8;
  border-radius: 20rpx;
}

.single-info {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  justify-content: center;
  gap: 6rpx;
}

.single-name {
  color: #1a1a1a;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 38rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.single-spec,
.single-count {
  color: #888888;
  font-size: 22rpx;
}

/* 多件商品：画廊横滚 */
.multi-thumbs-wrapper {
  flex: 1;
  min-width: 0;
  overflow: hidden;
}

.multi-thumbs-scroll {
  width: 100%;
  white-space: nowrap;
}

.multi-thumbs-inner {
  display: inline-flex;
  align-items: center;
  gap: 14rpx;
  padding-right: 12rpx;
}

.multi-thumb {
  flex-shrink: 0;
  width: 110rpx;
  height: 110rpx;
  background: #f7f9f8;
  border-radius: 18rpx;
}

.order-meta {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: center;
  flex-shrink: 0;
  gap: 8rpx;
}

.multi-meta {
  padding-left: 12rpx;
}

.order-total-row {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.total-count-text {
  color: #888888;
  font-size: 22rpx;
}

.total-price-wrap {
  display: flex;
  align-items: baseline;
  gap: 2rpx;
}

.total-label-text {
  color: #333333;
  font-size: 24rpx;
  font-weight: 600;
  margin-right: 2rpx;
}

.total-currency {
  color: #1a1a1a;
  font-size: 24rpx;
  font-weight: 700;
}

.total-amount {
  color: #1a1a1a;
  font-size: 36rpx;
  font-weight: 900;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
}

.delivery-time-text {
  color: #888888;
  font-size: 22rpx;
}

.order-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 16rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f2f4f3;
}

.order-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 148rpx;
  height: 60rpx;
  padding: 0 24rpx;
  margin: 0;
  box-sizing: border-box;
  font-size: 25rpx;
  font-weight: 600;
  line-height: 1;
  border-radius: 999rpx;
}

.order-btn::after {
  border: 0;
}

.btn-secondary {
  color: #555555;
  background: #ffffff;
  border: 1rpx solid #dddddd;
}

.btn-primary {
  color: #007a3d;
  background: #e8f7ee;
  border: 1rpx solid #b3e6c7;
  font-weight: 700;
}

.btn-pay {
  color: #ffffff;
  background: linear-gradient(135deg, #00b05b 0%, #007a3d 100%);
  font-weight: 800;
  box-shadow: 0 6rpx 16rpx rgba(0, 122, 61, 0.25);
}
