<view class="address-page {{glassMode ? 'glass-mode' : ''}}">
  <skeleton wx:if="{{loading}}" type="list" />
  <view class="address-header">
    <navigator class="back" open-type="navigateBack">
      <image class="back-icon" src="/assets/icons/back-green.svg" mode="aspectFit" />
    </navigator>
    <text class="title">收货地址</text>
    <view class="placeholder"></view>
  </view>

  <view wx:if="{{!addresses.length}}" class="empty-address card">
    <view class="empty-icon">
      <image class="empty-icon-image" src="/assets/icons/location-green.svg" mode="aspectFit" />
    </view>
    <text class="empty-title">还没有收货地址</text>
    <text class="empty-desc">添加常用地址后，下单时会自动带出配送信息，商家可以更快安排配送。</text>
    <button class="primary-button empty-add" bindtap="handleAdd">去新增地址</button>
  </view>

  <view wx:else class="address-list">
    <view
      wx:for="{{addresses}}"
      wx:key="id"
      class="address-card card {{selectMode && selectedId === item.id ? 'selected' : ''}}"
      data-id="{{item.id}}"
      bindtap="handleAddressCardTap"
    >
      <view class="address-main">
        <text class="receiver">{{item.name}} {{item.phone}}</text>
        <text wx:if="{{item.locationName}}" class="location-name">{{item.locationName}}</text>
        <text class="detail">{{item.detail}}</text>
      </view>
      <view class="address-actions">
        <text class="default {{item.isDefault ? 'active' : ''}}" data-id="{{item.id}}" catchtap="handleSetDefault">{{item.isDefault ? '默认地址' : '设为默认'}}</text>
        <view class="ops">
          <text data-id="{{item.id}}" catchtap="handleEdit">编辑</text>
          <text data-id="{{item.id}}" catchtap="handleDelete">删除</text>
        </view>
      </view>
    </view>
  </view>

  <button wx:if="{{addresses.length}}" class="primary-button add-address" bindtap="handleAdd">新增收货地址</button>

  <view wx:if="{{formVisible}}" class="form-mask">
    <view class="form-panel">
      <view class="form-heading">
        <view>
          <view class="form-title">{{form.id ? '编辑收货地址' : '新增收货地址'}}</view>
          <view class="form-subtitle">按顺序点选，不用在地图上查找</view>
        </view>
        <button class="form-close" disabled="{{saving}}" bindtap="handleCloseForm" aria-label="关闭">×</button>
      </view>

      <scroll-view class="form-scroll" scroll-y enhanced show-scrollbar="{{false}}">
        <view class="contact-section">
          <view class="section-caption">联系人</view>
          <view class="labeled-input">
            <text class="input-label">收货人</text>
            <input class="form-input" placeholder-class="form-placeholder" placeholder="请输入姓名" value="{{form.name}}" data-field="name" bindinput="handleInput" />
          </view>
          <view class="labeled-input">
            <text class="input-label">手机号</text>
            <input class="form-input" type="number" maxlength="11" placeholder-class="form-placeholder" placeholder="请输入 11 位手机号" value="{{form.phone}}" data-field="phone" bindinput="handleInput" />
          </view>
        </view>

        <view class="address-step">
          <view class="step-heading">
            <text class="step-number">1</text>
            <view class="step-copy">
              <text class="step-title">选择小区、楼号和单元</text>
              <text class="step-tip">一级一级选择，选错可重新点选</text>
            </view>
          </view>
          <view class="cascade-trigger {{form.community ? 'is-filled' : ''}}" bindtap="handleOpenAddressCascade">
            <view class="cascade-copy">
              <text class="cascade-label">{{form.community ? form.community + ' · ' + form.building + '号楼 · ' + form.unit + '单元' : '点这里开始选择'}}</text>
              <text class="cascade-tip">{{form.community ? '已选择，点击可修改' : '小区 → 楼号 → 单元'}}</text>
            </view>
            <image class="cascade-arrow" src="/assets/icons/chevron-right-gray.svg" mode="aspectFit" />
          </view>
        </view>

        <view wx:if="{{form.community}}" class="address-step">
          <view class="step-heading">
            <text class="step-number">2</text>
            <view class="step-copy">
              <text class="step-title">选择楼层</text>
              <text class="step-tip">先选几楼，再选门牌号</text>
            </view>
          </view>
          <view class="floor-grid">
            <button
              wx:for="{{floorOptions}}"
              wx:key="value"
              class="choice-button {{form.floor === item.value ? 'is-selected' : ''}}"
              data-floor="{{item.value}}"
              bindtap="handleFloorSelect"
            >{{item.label}}</button>
          </view>
        </view>

        <view wx:if="{{form.floor}}" class="address-step">
          <view class="step-heading">
            <text class="step-number">3</text>
            <view class="step-copy">
              <text class="step-title">选择门牌号</text>
              <text class="step-tip">当前选择：{{form.floor}}楼</text>
            </view>
          </view>
          <view class="room-grid">
            <button
              wx:for="{{roomOptions}}"
              wx:key="value"
              class="room-button {{form.room === item.value ? 'is-selected' : ''}}"
              data-room="{{item.value}}"
              bindtap="handleRoomSelect"
            >{{item.label}}</button>
          </view>
        </view>

        <view wx:if="{{addressSummary}}" class="address-preview">
          <text class="preview-label">最终收货地址</text>
          <text class="preview-value">{{addressSummary}}</text>
        </view>

        <label class="default-row">
          <checkbox checked="{{form.isDefault}}" bindchange="handleDefaultChange" color="#008f4c" />
          <view class="default-copy">
            <text class="default-title">设为默认地址</text>
            <text class="default-tip">下次下单优先使用这个地址</text>
          </view>
        </label>
      </scroll-view>

      <view class="form-actions">
        <button class="ghost-button" disabled="{{saving}}" bindtap="handleCloseForm">取消</button>
        <button class="primary-button save-button" loading="{{saving}}" disabled="{{saving}}" bindtap="handleSubmitForm">{{saving ? '保存中' : '保存地址'}}</button>
      </view>
    </view>
  </view>

  <t-cascader
    visible="{{addressCascadeVisible}}"
    value="{{cascadeValue}}"
    options="{{addressCascadeOptions}}"
    title="选择小区、楼号和单元"
    placeholder="请选择"
    sub-titles="{{cascadeSubTitles}}"
    theme="step"
    bind:change="handleAddressCascadeChange"
    bind:close="handleAddressCascadeClose"
  />
</view>
