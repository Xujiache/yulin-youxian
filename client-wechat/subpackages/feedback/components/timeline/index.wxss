.entry{display:flex;min-height:110rpx}.rail{position:relative;width:34rpx;display:flex;justify-content:center}.dot{position:relative;z-index:2;margin-top:12rpx;width:16rpx;height:16rpx;border:5rpx solid #dbeafe;border-radius:50%;background:var(--feedback-primary,#2563eb)}.line{position:absolute;top:34rpx;bottom:-12rpx;width:2rpx;background:#e4e7ec}.content{flex:1;padding:0 0 34rpx 14rpx}.meta{display:flex;justify-content:space-between;color:#98a2b3;font-size:22rpx}.sender{color:#344054;font-weight:600}.message{display:block;margin-top:12rpx;color:var(--feedback-text,#172033);font-size:28rpx;line-height:1.7;white-space:pre-wrap}
