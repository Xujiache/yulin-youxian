.grid{display:flex;flex-wrap:wrap;gap:18rpx}.image-wrap,.choose{position:relative;width:196rpx;height:196rpx;border-radius:14rpx;overflow:hidden}.image{width:100%;height:100%;background:#f2f4f7}.choose{display:flex;flex-direction:column;align-items:center;justify-content:center;border:2rpx dashed #cfd4dc;background:#f9fafb;color:#667085;font-size:24rpx}.choose::after{border:0}.plus{font-size:52rpx;line-height:1}.remove{position:absolute;right:6rpx;top:6rpx;z-index:4;width:44rpx;height:44rpx;padding:0;display:flex;align-items:center;justify-content:center;border-radius:50%;background:rgba(16,24,40,.75);color:#fff;font-size:34rpx;line-height:1}.remove::after{border:0}.mask{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:rgba(16,24,40,.55);color:#fff;font-size:24rpx}.mask.failed{flex-direction:column;background:rgba(180,35,24,.78)}.done{position:absolute;right:8rpx;bottom:8rpx;width:34rpx;height:34rpx;border-radius:50%;background:#12b76a;color:#fff;text-align:center;line-height:34rpx}.hint{display:block;margin-top:18rpx;color:#667085;font-size:22rpx;line-height:1.6}
