@import "../../styles/common.wxss";
.row{display:flex;justify-content:space-between;align-items:center}.time{color:#98a2b3;font-size:22rpx}.title{display:block;margin-top:22rpx;font-size:32rpx;font-weight:600}.description{display:block;margin-top:18rpx;font-size:28rpx;line-height:1.8;white-space:pre-wrap}.attachments{display:flex;flex-wrap:wrap;gap:14rpx;margin-top:24rpx}.attachment{width:190rpx;height:190rpx;border-radius:12rpx;background:#f2f4f7}.canonical-card,.supplement-card,.timeline-card{margin-top:22rpx}.canonical-row{display:flex;align-items:center;justify-content:space-between;margin-top:18rpx}.canonical-title,.canonical-resolution,.canonical-resolved-at{display:block;margin-top:16rpx}.canonical-title{font-size:28rpx;font-weight:600}.canonical-resolution{color:#344054;font-size:26rpx;line-height:1.7;white-space:pre-wrap}.canonical-resolved-at{color:#667085;font-size:22rpx}.supplement-card image-uploader{display:block;margin-top:24rpx}.supplement-button{height:84rpx;margin-top:24rpx}.empty-message{display:block;padding:30rpx 0;text-align:center;font-size:24rpx}
