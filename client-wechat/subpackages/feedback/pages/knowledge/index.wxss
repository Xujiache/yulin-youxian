@import "../../styles/common.wxss";
.list{display:flex;flex-direction:column;gap:20rpx}.row{display:flex;flex-direction:column;gap:10rpx}.title{font-size:30rpx;font-weight:600}.date{color:#98a2b3;font-size:22rpx}.content,.resolution{display:block;margin-top:18rpx;font-size:27rpx;line-height:1.7;white-space:pre-wrap}.resolution{padding:18rpx;background:#ecfdf3;border-radius:12rpx;color:#027a48}.preview{margin:18rpx 0 0;padding:0;text-align:left;background:transparent;color:var(--feedback-primary,#2563eb);font-size:25rpx}.preview::after{border:0}.more{text-align:center;padding:30rpx;color:#98a2b3;font-size:24rpx}
