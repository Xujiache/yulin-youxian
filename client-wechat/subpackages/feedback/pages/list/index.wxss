@import "../../styles/common.wxss";
.actions{display:grid;grid-template-columns:1fr 1fr;gap:18rpx;margin-bottom:26rpx}.actions button{height:82rpx;font-size:26rpx}.list{display:flex;flex-direction:column;gap:20rpx}.item{padding:26rpx}.row{display:flex;justify-content:space-between;align-items:center}.time{color:#98a2b3;font-size:22rpx}.summary{display:-webkit-box;margin-top:20rpx;overflow:hidden;-webkit-line-clamp:2;-webkit-box-orient:vertical;font-size:28rpx;line-height:1.6}.category{display:inline-block;margin-top:14rpx;color:#667085;font-size:22rpx}.more{text-align:center;padding:30rpx;color:#98a2b3;font-size:24rpx}
