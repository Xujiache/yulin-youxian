<view wx:if="{{visible}}" class="sheet-root">
  <view class="mask" bindtap="handleClose"></view>
  <view class="sheet {{glassMode ? 'glass-mode' : ''}}">
    <view class="sheet-header">
      <view class="sheet-image-wrap {{unavailable ? 'is-unavailable' : ''}}">
        <image class="sheet-image" src="{{product.image}}" mode="aspectFill" />
        <text wx:if="{{unavailable}}" class="sheet-image-status">{{availabilityLabel}}</text>
      </view>
      <view class="sheet-info">
        <text class="sheet-name">{{product.name}}</text>
        <text class="sheet-subtitle">{{product.subtitle}}</text>
        <text wx:if="{{!unavailable}}" class="sheet-price">￥{{unitPriceText}}/{{product.saleUnit}}</text>
        <text wx:else class="sheet-stock-empty">{{availabilityLabel}}，暂时无法购买</text>
      </view>
      <button class="close" bindtap="handleClose">
        <image class="close-icon" src="/assets/icons/close-gray.svg" mode="aspectFit" />
      </button>
    </view>

    <view wx:if="{{!unavailable}}" class="field-row">
      <view>
        <text class="field-title">购买数量</text>
        <text class="field-tip">最低 {{product.minPurchaseQty}}{{product.saleUnit}} 起购，每次增加 {{product.stepQty}}{{product.saleUnit}}</text>
      </view>
      <view class="sheet-stepper-row">
        <view class="sheet-stepper-control">
          <quantity-stepper
            value="{{quantity}}"
            min="{{product.minPurchaseQty || 1}}"
            max="{{product.stockQty}}"
            step="{{product.stepQty || 1}}"
            unit="{{product.saleUnit || ''}}"
            bind:change="handleQuantityChange"
          />
        </view>
      </view>
    </view>

    <view wx:if="{{!unavailable}}" class="summary">
      <text class="summary-label">小计</text>
      <text class="summary-price">￥{{amountText}}</text>
    </view>

    <view wx:else class="sheet-empty-tip">{{availabilityLabel === '商品已下架' ? '该商品已下架，请选择其他商品' : '该商品库存不足，请等待商家补货'}}</view>

    <button class="confirm {{unavailable ? 'is-disabled' : ''}}" bindtap="handleConfirm">{{unavailable ? availabilityLabel : '加入购物车'}}</button>
  </view>
</view>
