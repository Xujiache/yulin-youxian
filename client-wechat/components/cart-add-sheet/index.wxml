<view wx:if="{{visible}}" class="sheet-root">
  <view class="mask" bindtap="handleClose"></view>
  <view class="sheet {{glassMode ? 'glass-mode' : ''}}">
    <view class="sheet-header">
      <view class="sheet-image-wrap {{unavailable && !selectionIncomplete ? 'is-unavailable' : ''}}">
        <image class="sheet-image" src="{{displayImage || product.image}}" mode="aspectFill" />
        <text wx:if="{{unavailable && !selectionIncomplete}}" class="sheet-image-status">{{availabilityLabel}}</text>
      </view>
      <view class="sheet-info">
        <text class="sheet-name">{{product.name}}</text>
        <view class="sheet-price-row">
          <text class="sheet-price">￥{{unitPriceText}}</text>
          <text class="sheet-unit">/{{displaySaleUnit}}</text>
        </view>
        <text wx:if="{{!selectionIncomplete && !unavailable}}" class="sheet-stock">
          库存 {{displayStockQty}}{{displaySaleUnit}}
        </text>
        <text wx:elif="{{selectionIncomplete}}" class="sheet-selection-tip">请选择完整规格</text>
        <text wx:else class="sheet-stock-empty">{{availabilityLabel}}</text>
      </view>
      <button class="close" aria-label="关闭规格选择" bindtap="handleClose">
        <image class="close-icon" src="/assets/icons/close-gray.svg" mode="aspectFit" />
      </button>
    </view>

    <scroll-view wx:if="{{skuEnabled}}" class="spec-scroll" scroll-y>
      <view wx:for="{{displayGroups}}" wx:key="id" wx:for-item="group" class="spec-section">
        <text class="spec-title">{{group.name}}</text>
        <view class="spec-option-grid">
          <button
            wx:for="{{group.options}}"
            wx:key="id"
            wx:for-item="option"
            class="spec-chip {{option.selected ? 'is-selected' : ''}} {{option.disabled ? 'is-disabled' : ''}}"
            data-group-id="{{group.id}}"
            data-option-id="{{option.id}}"
            data-disabled="{{option.disabled}}"
            bindtap="handleSelectOption"
          >
            <text>{{option.name}}</text>
            <text wx:if="{{option.lowStock && !option.disabled}}" class="spec-low-stock">仅剩少量</text>
          </button>
        </view>
      </view>
    </scroll-view>

    <view wx:if="{{skuEnabled}}" class="selected-summary">
      <text class="selected-summary__label">已选</text>
      <text class="selected-summary__value">{{selectionText}}</text>
      <text wx:if="{{activeSku && activeSku.skuCode}}" class="selected-summary__code">{{activeSku.skuCode}}</text>
    </view>

    <view wx:if="{{!selectionIncomplete && !unavailable}}" class="field-row">
      <view>
        <text class="field-title">购买数量</text>
        <text class="field-tip">
          {{displayMinPurchaseQty}}{{displaySaleUnit}} 起购，每次增加 {{displayStepQty}}{{displaySaleUnit}}
        </text>
      </view>
      <view class="sheet-stepper-control">
        <quantity-stepper
          value="{{quantity}}"
          min="{{displayMinPurchaseQty}}"
          max="{{displayStockQty}}"
          step="{{displayStepQty}}"
          unit="{{displaySaleUnit}}"
          bind:change="handleQuantityChange"
        />
      </view>
    </view>

    <view wx:if="{{!unavailable && !selectionIncomplete}}" class="summary">
      <view>
        <text class="summary-label">商品小计</text>
        <text wx:if="{{skuEnabled}}" class="summary-spec">{{selectionText}}</text>
      </view>
      <text class="summary-price">￥{{amountText}}</text>
    </view>

    <view wx:elif="{{!selectionIncomplete}}" class="sheet-empty-tip">{{availabilityMessage}}</view>

    <button
      class="confirm {{unavailable || selectionIncomplete ? 'is-disabled' : ''}}"
      bindtap="handleConfirm"
    >
      {{selectionIncomplete ? '请选择完整规格' : unavailable ? availabilityLabel : confirmLabel}}
    </button>
  </view>
</view>
