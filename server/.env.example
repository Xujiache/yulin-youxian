# Copy these values into your deployment secret manager or local environment.
# Never commit a real API key, AppSecret, merchant private key, or platform certificate.
WECHAT_MINIAPP_DEVELOPMENT_MODE=false
WECHAT_MINIAPP_APP_ID=REPLACE_WITH_MINIAPP_APP_ID
WECHAT_MINIAPP_APP_SECRET=REPLACE_WITH_MINIAPP_APP_SECRET

WECHAT_PAY_DEVELOPMENT_MODE=false
WECHAT_PAY_APP_ID=REPLACE_WITH_MINIAPP_APP_ID
WECHAT_PAY_MCH_ID=REPLACE_WITH_MERCHANT_ID
WECHAT_PAY_API_V3_KEY=REPLACE_WITH_NEW_API_V3_KEY
WECHAT_PAY_MERCHANT_SERIAL_NO=REPLACE_WITH_MERCHANT_CERT_SERIAL
WECHAT_PAY_PRIVATE_KEY_PATH=./secrets/wechat-pay/apiclient_key.pem
WECHAT_PAY_PLATFORM_CERTIFICATE_PATH=./secrets/wechat-pay/wechatpay_platform.pem
WECHAT_PAY_BASE_URL=https://api.mch.weixin.qq.com
WECHAT_PAY_NOTIFY_URL=https://REPLACE_WITH_PUBLIC_HOST/api/wx/payments/wechat/notify
WECHAT_PAY_REFUND_NOTIFY_URL=https://REPLACE_WITH_PUBLIC_HOST/api/wx/refunds/wechat/notify
