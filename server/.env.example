# Copy these values into your deployment secret manager or local environment.
# Never commit a real API key, AppSecret, merchant private key, or platform certificate.
WECHAT_MINIAPP_APP_ID=REPLACE_WITH_MINIAPP_APP_ID
WECHAT_MINIAPP_APP_SECRET=REPLACE_WITH_MINIAPP_APP_SECRET

WECHAT_PAY_APP_ID=REPLACE_WITH_MINIAPP_APP_ID
WECHAT_PAY_MCH_ID=REPLACE_WITH_MERCHANT_ID
WECHAT_PAY_API_V3_KEY=REPLACE_WITH_NEW_API_V3_KEY
WECHAT_PAY_MERCHANT_SERIAL_NO=REPLACE_WITH_MERCHANT_CERT_SERIAL
WECHAT_PAY_PRIVATE_KEY_PATH=./secrets/wechat-pay/apiclient_key.pem
# Preferred verification mode for new integrations:
WECHAT_PAY_PUBLIC_KEY_ID=REPLACE_WITH_WECHAT_PAY_PUBLIC_KEY_ID
WECHAT_PAY_PUBLIC_KEY_PATH=./secrets/wechat-pay/wechatpay_pub_key.pem
# Legacy platform-certificate mode (leave empty when public-key mode is used):
WECHAT_PAY_PLATFORM_CERTIFICATE_PATH=
WECHAT_PAY_BASE_URL=https://api.mch.weixin.qq.com
WECHAT_PAY_NOTIFY_URL=https://REPLACE_WITH_PUBLIC_HOST/api/wx/payments/wechat/notify
WECHAT_PAY_REFUND_NOTIFY_URL=https://REPLACE_WITH_PUBLIC_HOST/api/wx/refunds/wechat/notify

# ── 随机减免（可选；活动开关与奖池在管理后台配置） ──
MARKETING_LOTTERY_CHALLENGE_TTL_SECONDS=600
MARKETING_LOTTERY_CONSISTENCY_SCAN_MS=300000
MARKETING_LOTTERY_CONSISTENCY_INITIAL_DELAY_MS=30000

# ── 配送域总开关 ──
DELIVERY_ENABLED=true
DELIVERY_STORE_LAT=30.1234567          # 必填，门店坐标（GCJ-02）
DELIVERY_STORE_LNG=120.7654321         # 必填
DELIVERY_UPLOAD_PATH=data/uploads/delivery

# ── 高德（可选，不填则用 Haversine 兜底） ──
AMAP_ENABLED=false
AMAP_WEB_KEY=                          # Web 服务 Key，仅服务端使用，绝不能进 APK
AMAP_JS_KEY=                           # JS API Key，下发给管理后台
# Android SDK Key 不在这里，它绑定包名+SHA1，配在 App 的 AndroidManifest

# ── 推送（可选，不填则纯轮询） ──
PUSH_PROVIDER=NOOP                     # NOOP | JPUSH
JPUSH_APP_KEY=
JPUSH_MASTER_SECRET=

# ── 隐私号（可选，不填则明文降级） ──
PRIVACY_NUMBER_PROVIDER=NOOP           # NOOP | ALIYUN_AXB
ALIYUN_AK_ID=
ALIYUN_AK_SECRET=
ALIYUN_PNP_POOL_KEY=

# ── 调度 ──
DISPATCH_LOOP_ENABLED=true
DISPATCH_LOOP_INTERVAL_MS=5000

# ── 轨迹清理 ──
TRACKING_CLEANUP_CRON=0 30 3 * * *     # 每天 03:30
