# 工具链与数据库基线的唯一来源。
#
# 这个文件不含任何机密，必须随仓库走：build-release.sh 在第一步就 source 它，
# 拿不到就整个发布流程都跑不起来，go-live 也要读 release 包里的同名副本
# 复核服务器上的 Node 与 Java。
#
# 改版本号只改这里，不要在脚本或文档里另写一份。

# 后端编译与运行的 JDK 主版本，与 server/pom.xml 的 java.version 一致
JAVA_VERSION=17

# 管理后台构建用的 Node，与 npm 一同锁死；npm 取 Node 22.14.0 随附的版本
NODE_VERSION=22.14.0
NPM_VERSION=10.9.2

# 数据库基线：迁移目标版本与迁移完成后的业务表张数，
# 与 server/src/main/resources/db/migration 及 server/scripts/readiness.sql 对齐
EXPECTED_FLYWAY_VERSION=11
EXPECTED_BUSINESS_TABLES=36
